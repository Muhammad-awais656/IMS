@model IMS.Models.EmployeeLedgerEntryVM
@{
    ViewBag.Title = "View Ledger Entry";
    var employeeName = ViewBag.EmployeeName as string ?? "";
    var voucherTypeName = ViewBag.VoucherTypeName as string ?? "";
    var nature = ViewBag.Nature as string ?? "";
    var amountLabel = nature == "D" ? "Debit Amount" : "Credit Amount";
}

<div class="card shadow-sm">
    <div class="card-header bg-primary text-white py-3">
        <div class="d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center">
                <i class="fa fa-eye me-2"></i>
                <h4 class="mb-0">View Ledger Entry</h4>
            </div>
            <a asp-action="EmployeeLedger" asp-controller="Employee" class="btn btn-light btn-sm">
                <i class="fa fa-arrow-left me-1"></i>Back to Ledger
            </a>
        </div>
    </div>
    <div class="card-body p-4">
        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label text-muted small">Employee</label>
                <p class="form-control-plaintext fw-semibold mb-0">@employeeName</p>
            </div>
            <div class="col-md-6 mb-3">
                <label class="form-label text-muted small">Voucher Type</label>
                <p class="form-control-plaintext fw-semibold mb-0">@voucherTypeName</p>
            </div>
            <div class="col-md-6 mb-3">
                <label class="form-label text-muted small">Voucher Date</label>
                <p class="form-control-plaintext fw-semibold mb-0">@Model.VoucherDate.ToString("dd-MMM-yyyy")</p>
            </div>
            <div class="col-md-6 mb-3">
                <label class="form-label text-muted small">@amountLabel</label>
                <p class="form-control-plaintext fw-semibold mb-0">@Model.Amount.ToString("N2")</p>
            </div>
            <div class="col-md-6 mb-3">
                <label class="form-label text-muted small">Reference No</label>
                <p class="form-control-plaintext mb-0">@(Model.ReferenceNo ?? "-")</p>
            </div>
            <div class="col-md-12 mb-3">
                <label class="form-label text-muted small">Remarks</label>
                <p class="form-control-plaintext mb-0">@(Model.Remarks ?? "-")</p>
            </div>
        </div>
        <div class="d-flex gap-2 mt-3">
            <a asp-action="EditLedgerEntry" asp-route-id="@Model.LedgerId" class="btn btn-warning">
                <i class="fa fa-edit me-1"></i>Edit
            </a>
            <a asp-action="DeleteLedgerEntry" asp-route-id="@Model.LedgerId" class="btn btn-danger">
                <i class="fa fa-trash me-1"></i>Delete
            </a>
        </div>
    </div>
</div>
