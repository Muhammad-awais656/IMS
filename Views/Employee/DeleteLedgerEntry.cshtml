@model IMS.Models.EmployeeLedgerEntryVM
@{
    ViewBag.Title = "Delete Ledger Entry";
    var employeeName = ViewBag.EmployeeName as string ?? "";
    var voucherTypeName = ViewBag.VoucherTypeName as string ?? "";
}

<div class="card shadow-sm">
    <div class="card-header bg-danger text-white py-3">
        <div class="d-flex align-items-center">
            <i class="fa fa-trash me-2"></i>
            <h4 class="mb-0">Delete Ledger Entry</h4>
        </div>
    </div>
    <div class="card-body p-4">
        <div class="alert alert-warning mb-4">
            <i class="fa fa-exclamation-triangle me-2"></i>
            <strong>Are you sure you want to delete this ledger entry?</strong> This action cannot be undone.
        </div>
        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label text-muted small">Employee</label>
                <p class="form-control-plaintext fw-semibold mb-0">@employeeName</p>
            </div>
            <div class="col-md-6 mb-3">
                <label class="form-label text-muted small">Voucher Type</label>
                <p class="form-control-plaintext fw-semibold mb-0">@voucherTypeName</p>
            </div>
            <div class="col-md-6 mb-3">
                <label class="form-label text-muted small">Voucher Date</label>
                <p class="form-control-plaintext fw-semibold mb-0">@Model.VoucherDate.ToString("dd-MMM-yyyy")</p>
            </div>
            <div class="col-md-6 mb-3">
                <label class="form-label text-muted small">Amount</label>
                <p class="form-control-plaintext fw-semibold mb-0">@Model.Amount.ToString("N2")</p>
            </div>
            @if (!string.IsNullOrEmpty(Model.ReferenceNo))
            {
                <div class="col-md-6 mb-3">
                    <label class="form-label text-muted small">Reference No</label>
                    <p class="form-control-plaintext mb-0">@Model.ReferenceNo</p>
                </div>
            }
        </div>
        <form asp-action="DeleteLedgerEntry" asp-route-id="@Model.LedgerId" method="post" class="d-inline">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-danger">
                <i class="fa fa-trash me-1"></i>Delete
            </button>
        </form>
        <a asp-action="EmployeeLedger" asp-controller="Employee" class="btn btn-outline-secondary">
            <i class="fa fa-arrow-left me-1"></i>Cancel
        </a>
    </div>
</div>
