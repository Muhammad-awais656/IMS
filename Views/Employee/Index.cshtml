@model IMS.Models.EmployeeViewModel;
@{
    bool isAdmin = Convert.ToBoolean(User.FindFirst("IsAdmin")?.Value);
    string role = isAdmin ? "Admin" : "User";
    ViewBag.Title = "Employees List";
}

<link href="~/css/product-management.css" rel="stylesheet" />
<link href="~/css/user-management.css" rel="stylesheet" />

@* <div class="container ms-0"> *@
<div class="card shadow-sm">
    <div class="card-header bg-primary text-white">
        <h2 class="mb-0" style="text-align:center"> Employee Management</h2>
    </div>
    <div class="card-body">
        <!-- Enhanced Search Section -->
        <div class="card mb-4 user-search-card">
            <div class="card-header user-search-header bg-transparent border-0 py-3">
                <div class="d-flex align-items-center justify-content-between">
                    <h5 class="mb-0 user-search-title">
                        <i class="fa-solid fa-search user-search-icon me-2"></i>Search & Actions
                    </h5>
                </div>
            </div>
            <div class="card-body user-search-section pt-0">
                <form asp-action="Index" asp-controller="Employee" asp-route-searchUsername="@ViewData["searchUsername"]" method="get">
                    
                    <div class="row g-3 align-items-end">
                        <!-- Search Input -->
                        <div class="col-md-6">
                            <div class="form-floating user-search-floating">
                                <input type="text"
                                       name="searchUsername"
                                       value="@Context.Request.Query["searchUsername"]"
                                       class="form-control user-search-input"
                                       placeholder="Enter employee name"
                                       onchange="SearchNameChange()" />
                                <label class="text-muted">
                                    <i class="fa-solid fa-user-tie me-1"></i>Search by Employee Name
                                </label>
                            </div>
                        </div>
                        
                        <!-- Action Buttons -->
                        <div class="col-md-6">
                            <div class="d-flex user-button-group justify-content-end">
                                <button type="submit" class="btn btn-user-search">
                                    <i class="fa-solid fa-magnifying-glass me-2"></i>Search
                                </button>
                                <a asp-action="Index" class="btn btn-user-reset">
                                    <i class="fa-solid fa-refresh me-2"></i>Refresh
                                </a>
                                <a href="#" id="exportExcelBtn" class="btn btn-warning btn-sm">
                                    <i class="fa fa-file-excel text-success me-1"></i> Export Excel
                                </a>
                                <a href="#" id="exportPdfBtn" class="btn btn-warning btn-sm">
                                    <i class="fa fa-file-pdf text-danger me-1"></i> Export PDF
                                </a>
                                <a asp-action="Create" class="btn btn-user-create">
                                    <i class="fa-solid fa-plus me-2"></i>Create Employee
                                </a>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
        <div class="table-responsive">
            <table class="table table-striped table-bordered custom-table">
                <thead>
                    <tr>
                        <th>@Html.DisplayNameFor(model => model.EmployeesList[0].FirstName) </th>
                        <th>@Html.DisplayNameFor(model => model.EmployeesList[0].LastName)</th>
                        <th>@Html.DisplayNameFor(model => model.EmployeesList[0].PhoneNumber)</th>
                        <th>@Html.DisplayNameFor(model => model.EmployeesList[0].HusbandFatherName)</th>
                        <th>@Html.DisplayNameFor(model => model.EmployeesList[0].Cnic)</th>
                        <th>@Html.DisplayNameFor(model => model.EmployeesList[0].Salary)</th>
                        <th>@Html.DisplayNameFor(model => model.EmployeesList[0].EmailAddress)</th>
                        <th>@Html.DisplayNameFor(model => model.EmployeesList[0].JoiningDate)</th>
                        <th>@Html.DisplayNameFor(model => model.EmployeesList[0].Gender)</th>
                        <th>@Html.DisplayNameFor(model => model.EmployeesList[0].MaritalStatus)</th>
                        <th>@Html.DisplayNameFor(model => model.EmployeesList[0].Age)</th>
                        


                        <th>Actions</th>


                    </tr>
                </thead>
                <tbody>
                    @if (Model.EmployeesList.Any())
                    {
                        @foreach (var item in Model.EmployeesList)
                        {
                            <tr>
                                <td>@Html.DisplayFor(modelItem => item.FirstName)</td>
                                <td>@Html.DisplayFor(modelitem => item.LastName)</td>
                                <td>@Html.DisplayFor(modelitem => item.PhoneNumber)</td>
                                <td>@Html.DisplayFor(modelitem => item.HusbandFatherName)</td>
                                <td>@Html.DisplayFor(modelitem => item.Cnic)</td>
                                <td>@Html.DisplayFor(modelitem => item.Salary)</td>
                                <td>@Html.DisplayFor(modelitem => item.EmailAddress)</td>
                                <td>@Html.DisplayFor(modelitem => item.JoiningDate)</td>
                                <td>@Html.DisplayFor(modelitem => item.Gender)</td>
                                <td>@Html.DisplayFor(modelitem => item.MaritalStatus)</td>
                                <td>@Html.DisplayFor(modelitem => item.Age)</td>


                                

                                <td class="table-actions">
                                    <div class="btn-group" role="group">
                                        <a asp-action="Details" asp-route-id="@item.EmployeeId" class="btn btn-sm btn-outline-info" title="View Details">
                                            <i class="fa-solid fa-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@item.EmployeeId" class="btn btn-sm btn-outline-warning" title="Edit Employee">
                                            <i class="fa-solid fa-edit"></i>
                                        </a>
                                         <button type="button" class="btn btn-sm btn-outline-primary"
                                                title="Transaction History"
                                                data-employee-id="@item.EmployeeId"
                                                data-employee-name="@((item.FirstName + " " + (item.LastName ?? "")).Trim())"
                                                onclick="showEmployeeTransactionHistory(this.getAttribute('data-employee-id'), this.getAttribute('data-employee-name'))">
                                            <i class="fa fa-history"></i>
                                        </button>
                                        <a asp-action="Delete" asp-route-id="@item.EmployeeId" class="btn btn-sm btn-outline-danger" title="Delete Employee">
                                            <i class="fa-solid fa-trash"></i>
                                        </a>
                                    </div>
                                </td>


                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center">No Record found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="d-flex justify-content-between align-items-center mt-3">
            <span class="text-muted">Total: @Model.TotalCount | Showing @Model.PageSize Records per page</span>
                <div class="end-0">
                    <label for="pageSize" class="form-label me-2 text-muted">Items Per Page :</label>
                    <select id="pageSize" class="form-select form-select-sm d-inline-block w-auto" onchange="changePageSize(this)">
                        <option value="5" selected="@(Model.PageSize == 5)">5</option>
                        <option value="10" selected="@(Model.PageSize == 10)">10</option>
                        <option value="25" selected="@(Model.PageSize == 25)">25</option>
                    </select>
                </div>
            @if (Model.TotalPages > 1)
            {
                <nav aria-label="User pagination">
                    <ul class="pagination justify-content-center">
                        <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                            <a class="page-link" asp-action="Index" asp-route-pageNumber="1"
                               asp-route-pageSize="@Model.PageSize" asp-route-searchUsername="@ViewData["searchUsername"]">First</a>
                        </li>
                        <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                            <a class="page-link" asp-action="Index" asp-route-pageNumber="@(Model.CurrentPage - 1)" asp-route-pageSize="@Model.PageSize"
                               asp-route-searchUsername="@ViewData["searchUsername"]">Previous</a>
                        </li>
                        @{
                            int startPage = Math.Max(1, Model.CurrentPage - 1);
                            int endPage = Math.Min(Model.TotalPages, startPage + 2);
                            if (endPage - startPage < 2)
                            {
                                startPage = Math.Max(1, endPage - 2);
                            }

                        }
                        @for (int i = startPage; i <= endPage; i++)
                        {
                            <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                <a class="page-link" asp-action="Index" asp-route-pageNumber="@i" asp-route-pageSize="@Model.PageSize" asp-route-searchUsername="@ViewData["searchUsername"]">@i</a>
                            </li>
                        }
                        <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                            <a class="page-link" asp-action="Index" asp-route-pageNumber="@(Model.CurrentPage + 1)" asp-route-pageSize="@Model.PageSize" asp-route-searchUsername="@ViewData["searchUsername"]">Next</a>
                        </li>
                        <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                            <a class="page-link" asp-action="Index" asp-route-pageNumber="@Model.TotalPages" asp-route-pageSize="@Model.PageSize" asp-route-searchUsername="@ViewData["searchUsername"]">Last</a>
                        </li>
                    </ul>
                </nav>
            }
        </div>
    </div>
</div>
@* </div> *@

<!-- Transaction History Modal -->
<div class="modal fade" id="employeeTransactionHistoryModal" tabindex="-1" aria-labelledby="employeeTransactionHistoryModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="employeeTransactionHistoryModalLabel">
                    <i class="fa-solid fa-history me-2"></i>Transaction History
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="row mb-3">
                    <div class="col-md-6">
                        <h6><strong>Employee:</strong></h6>
                        <p class="mb-1"><span id="modalEmployeeName" class="fw-bold"></span></p>
                    </div>
                    <div class="col-md-6">
                        <h6><strong>Summary:</strong></h6>
                        <p class="mb-1"><strong>Current Balance:</strong> <span id="modalEmployeeBalance" class="fw-bold"></span></p>
                        <p class="mb-1"><strong>Total Transactions:</strong> <span id="modalEmployeeTransactionCount"></span></p>
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-3">
                        <label for="empHistoryFromDate" class="form-label">From Date:</label>
                        <input type="date" id="empHistoryFromDate" class="form-control">
                    </div>
                    <div class="col-md-3">
                        <label for="empHistoryToDate" class="form-label">To Date:</label>
                        <input type="date" id="empHistoryToDate" class="form-control">
                    </div>
                    <div class="col-md-3 d-flex align-items-end">
                        <button type="button" class="btn btn-primary" onclick="loadEmployeeTransactionHistory()">
                            <i class="fa-solid fa-search me-1"></i>Filter
                        </button>
                    </div>
                </div>

                <div id="empHistoryLoading" class="text-center py-4" style="display: none;">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <p class="mt-2">Loading transaction history...</p>
                </div>

                <div class="table-responsive">
                    <table class="table table-striped table-hover" id="employeeTransactionHistoryTable">
                        <thead class="table-dark">
                            <tr>
                                <th>Date</th>
                                <th>Type</th>
                                <th>Amount</th>
                                <th>Balance</th>
                                <th>Description</th>
                                <th>Reference</th>
                            </tr>
                        </thead>
                        <tbody id="employeeTransactionHistoryBody">
                        </tbody>
                    </table>
                </div>

                <nav aria-label="Transaction history pagination" id="empHistoryPagination" style="display: none;">
                    <ul class="pagination justify-content-center" id="empHistoryPaginationList"></ul>
                </nav>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Transaction History modal state
        let currentEmployeeId = null;
        let currentEmployeeName = '';
        const empHistoryPageSize = 10;

        function showEmployeeTransactionHistory(employeeId, employeeName) {
            currentEmployeeId = employeeId;
            currentEmployeeName = employeeName || '';
            document.getElementById('modalEmployeeName').textContent = currentEmployeeName;
            document.getElementById('empHistoryFromDate').value = '';
            document.getElementById('empHistoryToDate').value = '';
            var modal = new bootstrap.Modal(document.getElementById('employeeTransactionHistoryModal'));
            modal.show();
            loadEmployeeTransactionHistory();
        }

        function loadEmployeeTransactionHistory(page) {
            page = page || 1;
            if (!currentEmployeeId) return;
            document.getElementById('empHistoryLoading').style.display = 'block';
            document.getElementById('employeeTransactionHistoryTable').style.display = 'none';
            document.getElementById('empHistoryPagination').style.display = 'none';
            var fromDate = document.getElementById('empHistoryFromDate').value;
            var toDate = document.getElementById('empHistoryToDate').value;
            var params = new URLSearchParams({ employeeId: currentEmployeeId, pageNumber: page, pageSize: empHistoryPageSize });
            if (fromDate) params.append('fromDate', fromDate);
            if (toDate) params.append('toDate', toDate);
            fetch('/Employee/GetTransactionHistory?' + params.toString())
                .then(function(r) { return r.json(); })
                .then(function(data) { displayEmployeeTransactionHistory(data); })
                .catch(function(err) { console.error(err); showEmpHistoryError('Failed to load transaction history.'); })
                .finally(function() {
                    document.getElementById('empHistoryLoading').style.display = 'none';
                    document.getElementById('employeeTransactionHistoryTable').style.display = 'table';
                });
        }

        function displayEmployeeTransactionHistory(data) {
            var tbody = document.getElementById('employeeTransactionHistoryBody');
            tbody.innerHTML = '';
            if (data.transactions && data.transactions.length > 0) {
                if (data.employeeSummary) {
                    document.getElementById('modalEmployeeBalance').textContent = 'Rs ' + parseFloat(data.employeeSummary.currentBalance).toFixed(2);
                    document.getElementById('modalEmployeeTransactionCount').textContent = data.employeeSummary.transactionCount;
                }
                data.transactions.forEach(function(t) {
                    var type = t.debitAmount > 0 ? 'Debit' : 'Credit';
                    var amount = t.debitAmount > 0 ? t.debitAmount : t.creditAmount;
                    var row = document.createElement('tr');
                    row.innerHTML = '<td>' + new Date(t.voucherDate).toLocaleDateString() + '</td>' +
                        '<td><span class="badge ' + (type === 'Credit' ? 'bg-success' : 'bg-danger') + '">' + type + '</span></td>' +
                        '<td class="text-end ' + (type === 'Credit' ? 'text-success' : 'text-danger') + '">Rs ' + parseFloat(amount).toFixed(2) + '</td>' +
                        '<td class="text-end fw-bold">Rs ' + parseFloat(t.runningBalance).toFixed(2) + '</td>' +
                        '<td>' + (t.voucherTypeName || '-') + (t.remarks ? ': ' + t.remarks : '') + '</td>' +
                        '<td>' + (t.referenceNo || '-') + '</td>';
                    tbody.appendChild(row);
                });
                if (data.totalPages > 1) {
                    displayEmpHistoryPagination(data.currentPage, data.totalPages);
                    document.getElementById('empHistoryPagination').style.display = 'block';
                }
            } else {
                tbody.innerHTML = '<tr><td colspan="6" class="text-center text-muted py-4">No transactions found</td></tr>';
            }
        }

        function displayEmpHistoryPagination(currentPage, totalPages) {
            var list = document.getElementById('empHistoryPaginationList');
            list.innerHTML = '';
            var prevLi = document.createElement('li');
            prevLi.className = 'page-item ' + (currentPage === 1 ? 'disabled' : '');
            prevLi.innerHTML = '<a class="page-link" href="#" onclick="loadEmployeeTransactionHistory(' + (currentPage - 1) + '); return false;">Previous</a>';
            list.appendChild(prevLi);
            var startPage = Math.max(1, currentPage - 2), endPage = Math.min(totalPages, currentPage + 2);
            for (var i = startPage; i <= endPage; i++) {
                var li = document.createElement('li');
                li.className = 'page-item ' + (i === currentPage ? 'active' : '');
                li.innerHTML = '<a class="page-link" href="#" onclick="loadEmployeeTransactionHistory(' + i + '); return false;">' + i + '</a>';
                list.appendChild(li);
            }
            var nextLi = document.createElement('li');
            nextLi.className = 'page-item ' + (currentPage === totalPages ? 'disabled' : '');
            nextLi.innerHTML = '<a class="page-link" href="#" onclick="loadEmployeeTransactionHistory(' + (currentPage + 1) + '); return false;">Next</a>';
            list.appendChild(nextLi);
        }

        function showEmpHistoryError(message) {
            document.getElementById('employeeTransactionHistoryBody').innerHTML = '<tr><td colspan="6" class="text-center text-danger py-4">' + message + '</td></tr>';
        }

        // Enhanced Employee Management JavaScript

        // Initialize page
        document.addEventListener('DOMContentLoaded', function() {
            initializeEmployeeManagement();
        });

        function initializeEmployeeManagement() {
            // Add loading states to buttons
            addLoadingStates();
            
            // Add smooth animations
            addSmoothAnimations();
            
            // Add form validation feedback
            addFormValidation();
        }

        function addLoadingStates() {
            const searchBtn = document.querySelector('.btn-user-search');
            const resetBtn = document.querySelector('.btn-user-reset');
            
            if (searchBtn) {
                searchBtn.addEventListener('click', function() {
                    this.classList.add('btn-loading');
                    this.innerHTML = '<i class="fa-solid fa-spinner fa-spin me-2"></i>Searching...';
                });
            }
            
            if (resetBtn) {
                resetBtn.addEventListener('click', function() {
                    this.classList.add('btn-loading');
                    this.innerHTML = '<i class="fa-solid fa-spinner fa-spin me-2"></i>Refreshing...';
                });
            }
        }

        function addSmoothAnimations() {
            // Add hover effects to form elements
            const formElements = document.querySelectorAll('.form-floating');
            formElements.forEach(element => {
                element.addEventListener('mouseenter', function() {
                    this.style.transform = 'translateY(-2px)';
                    this.style.transition = 'transform 0.3s ease';
                });
                
                element.addEventListener('mouseleave', function() {
                    this.style.transform = 'translateY(0)';
                });
            });
        }

        function addFormValidation() {
            const inputs = document.querySelectorAll('.form-control, .form-select');
            inputs.forEach(input => {
                input.addEventListener('blur', function() {
                    if (this.value.trim() !== '') {
                        this.classList.add('is-valid');
                        this.classList.remove('is-invalid');
                    } else {
                        this.classList.remove('is-valid');
                    }
                });
                
                input.addEventListener('input', function() {
                    if (this.classList.contains('is-invalid')) {
                        this.classList.remove('is-invalid');
                    }
                });
            });
        }

        function SearchNameChange() {
            // Add loading state
            const searchBtn = document.querySelector('.btn-user-search');
            if (searchBtn) {
                searchBtn.classList.add('btn-loading');
            }
            
            // Get form values
            const form = document.querySelector('form');
            const formData = new FormData(form);
            const params = new URLSearchParams();
            
            // Add all form data to params
            for (let [key, value] of formData.entries()) {
                if (value.trim() !== '') {
                    params.append(key, value);
                }
            }
            
            // Add pagination
            params.set('pageNumber', '1');
            params.set('pageSize', document.getElementById('pageSize')?.value || '10');
            
            // Redirect with parameters
            window.location.href = '@Url.Action("Index", "Employee")' + '?' + params.toString();
        }

        function changePageSize(select) {
            // Add loading state
            const searchBtn = document.querySelector('.btn-user-search');
            if (searchBtn) {
                searchBtn.classList.add('btn-loading');
            }
            
            // Get current form values
            const form = document.querySelector('form');
            const formData = new FormData(form);
            const params = new URLSearchParams();
            
            // Add all form data to params
            for (let [key, value] of formData.entries()) {
                if (value.trim() !== '') {
                    params.append(key, value);
                }
            }
            
            // Add pagination
            params.set('pageNumber', '1');
            params.set('pageSize', select.value);
            
            // Redirect with parameters
            window.location.href = '@Url.Action("Index", "Employee")' + '?' + params.toString();
        }

        // Add keyboard shortcuts
        document.addEventListener('keydown', function(e) {
            // Ctrl + Enter to search
            if (e.ctrlKey && e.key === 'Enter') {
                e.preventDefault();
                const searchBtn = document.querySelector('.btn-user-search');
                if (searchBtn) {
                    searchBtn.click();
                }
            }
            
            // Escape to reset
            if (e.key === 'Escape') {
                const resetBtn = document.querySelector('.btn-user-reset');
                if (resetBtn) {
                    resetBtn.click();
                }
            }
        });

        // Add tooltips
        document.addEventListener('DOMContentLoaded', function() {
            const tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
            tooltipTriggerList.map(function (tooltipTriggerEl) {
                return new bootstrap.Tooltip(tooltipTriggerEl);
            });
        });

        function getEmployeeExportParams() {
            return { firstName: document.querySelector('input[name="searchUsername"]')?.value || '' };
        }
        document.getElementById("exportExcelBtn").addEventListener("click", function (e) {
            e.preventDefault();
            var p = getEmployeeExportParams();
            var url = '@Url.Action("ExportExcel", "Employee")' + (p.firstName ? '?firstName=' + encodeURIComponent(p.firstName) : '');
            exportWithLoader(url, 'Employees_export.xlsx', 'Preparing Excel export... Please wait.');
        });
        document.getElementById("exportPdfBtn").addEventListener("click", function (e) {
            e.preventDefault();
            var p = getEmployeeExportParams();
            var url = '@Url.Action("ExportPdf", "Employee")' + (p.firstName ? '?firstName=' + encodeURIComponent(p.firstName) : '');
            exportWithLoader(url, 'Employees_export.pdf', 'Preparing PDF export... Please wait.');
        });
    </script>
}