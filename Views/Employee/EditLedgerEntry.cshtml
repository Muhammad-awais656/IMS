@using IMS.Models
@using Microsoft.AspNetCore.Mvc.Rendering
@model EmployeeLedgerEntryVM

<div class="card shadow-sm">
    <div class="card-header bg-warning text-dark py-3">
        <div class="d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center">
                <i class="fa fa-edit me-2"></i>
                <h4 class="mb-0">Edit Employee Ledger Entry</h4>
            </div>
            <a asp-action="EmployeeLedger" asp-controller="Employee" class="btn btn-dark btn-sm">
                <i class="fa fa-arrow-left me-1"></i>Back to Ledger
            </a>
        </div>
    </div>
    <div class="card-body p-4">
        <form asp-action="EditLedgerEntry" method="post" novalidate>
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="LedgerId" />

            <div class="row">
                <div class="col-lg-3 col-md-6 mb-4">
                    <label class="form-label fw-semibold text-dark">
                        <i class="fa-solid fa-user me-1 text-primary"></i>Employee <span class="text-danger">*</span>
                    </label>
                    @Html.DropDownListFor(x => x.EmployeeId, ViewBag.Employees as SelectList, "-- Select Employee --", new { @class = "form-control form-control-lg" })
                    <span asp-validation-for="EmployeeId" class="text-danger small"></span>
                </div>
                <div class="col-md-6 mb-4">
                    <label asp-for="VoucherTypeId" class="form-label fw-semibold">
                        <i class="fa fa-file-invoice me-1 text-primary"></i>Voucher Type <span class="text-danger">*</span>
                    </label>
                    @Html.DropDownListFor(x => x.VoucherTypeId, ViewBag.VoucherTypes as SelectList, "-- Select Voucher Type --", new { @class = "form-control form-control-lg" })
                    <span asp-validation-for="VoucherTypeId" class="text-danger small"></span>
                </div>
                <div class="col-md-6 mb-4">
                    <label asp-for="VoucherDate" class="form-label fw-semibold">
                        <i class="fa fa-calendar me-1 text-primary"></i>Voucher Date <span class="text-danger">*</span>
                    </label>
                    <input asp-for="VoucherDate" type="date" class="form-control form-control-lg" />
                    <span asp-validation-for="VoucherDate" class="text-danger small"></span>
                </div>
                <div class="col-md-6 mb-4">
                    <label asp-for="Amount" class="form-label fw-semibold">
                        <i class="fa fa-money-bill-wave me-1 text-primary"></i>Amount <span class="text-danger">*</span>
                    </label>
                    <input asp-for="Amount" class="form-control form-control-lg" type="number" step="0.001" placeholder="Enter amount" />
                    <span asp-validation-for="Amount" class="text-danger small"></span>
                </div>
                <div class="col-md-6 mb-4">
                    <label asp-for="ReferenceNo" class="form-label fw-semibold">
                        <i class="fa fa-hashtag me-1 text-primary"></i>Reference No <span class="text-muted fw-normal">(Optional)</span>
                    </label>
                    <input asp-for="ReferenceNo" class="form-control form-control-lg" placeholder="Enter reference number (optional)" />
                </div>
                <div class="col-md-6 mb-4">
                    <label asp-for="Remarks" class="form-label fw-semibold">
                        <i class="fa fa-comment me-1 text-primary"></i>Remarks <span class="text-muted fw-normal">(Optional)</span>
                    </label>
                    <textarea asp-for="Remarks" class="form-control" rows="3" placeholder="Optional remarks"></textarea>
                </div>
            </div>

            <div class="row mt-3">
                <div class="col-12">
                    <div class="alert alert-light border small mb-0">
                        <strong class="d-block mb-2"><i class="fa fa-info-circle me-1 text-primary"></i>Voucher types – Debit vs Credit</strong>
                        <div class="row">
                            <div class="col-md-6"><span class="text-danger fw-semibold">Debit (D):</span> <span class="text-muted">Opening Balance, Salary, Adjustment</span></div>
                            <div class="col-md-6"><span class="text-success fw-semibold">Credit (C):</span> <span class="text-muted">Advance, Loan, Deduction, Payment</span></div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="d-grid gap-2 d-md-flex justify-content-md-end mt-3">
                <a asp-action="EmployeeLedger" asp-controller="Employee" class="btn btn-outline-secondary btn-lg me-md-2">
                    <i class="fa fa-times me-1"></i>Cancel
                </a>
                <button type="submit" class="btn btn-warning btn-lg">
                    <i class="fa fa-save me-1"></i>Update Ledger Entry
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
