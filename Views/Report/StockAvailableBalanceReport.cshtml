@model IMS.Models.DailyStockReportViewModel
@{
    var ps = Model.PageSize ?? 10;
}
<div class="card shadow-sm">
    <div class="card-header bg-primary text-white py-3">
        <div class="d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center">
                <i class="fa fa-scale-balanced me-2"></i>
                <h4 class="mb-0">Stock Available Balance Report</h4>
            </div>
            <div class="d-flex gap-2">
                <a href="#" id="exportExcelBtn" class="btn btn-warning btn-sm">
                    <i class="fa fa-file-excel text-success me-1"></i> Export Excel
                </a>
                <a href="#" id="exportPdfBtn" class="btn btn-warning btn-sm">
                    <i class="fa fa-file-pdf text-danger me-1"></i> Export PDF
                </a>
            </div>
        </div>
    </div>
    <div class="card-body p-4">
        <div class="card mb-4">
            <div class="card-header bg-light">
                <h5 class="mb-0">
                    <i class="fa fa-filter me-2 text-primary"></i>Filter Options
                </h5>
            </div>
            <div class="card-body">
                <form id="filterForm" asp-action="StockAvailableBalanceReport" asp-controller="Report" method="get">
                    <input type="hidden" name="Filters.DisplayMeasuringUnitId" id="displayMeasuringUnitIdHidden"
                           value="@(Model.Filters?.DisplayMeasuringUnitId?.ToString() ?? "")" />
                    <div class="row g-3">
                        <div class="col-md-3">
                            <label class="form-label fw-semibold" for="productComboBox">
                                <i class="fa fa-gift me-1 text-primary"></i>Product
                            </label>
                            <input id="productComboBox" name="Filters.ProductId"
                                   value="@(Model.Filters?.ProductId?.ToString() ?? "")"
                                   style="width: 100%;"
                                   autocomplete="off" />
                            <span class="text-muted small">Leave empty for all enabled products.</span>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-semibold">
                                <i class="fa fa-calendar me-1 text-primary"></i>As of date
                            </label>
                            <input type="date" name="Filters.ReportDate"
                                   value="@(Model.Filters?.ReportDate.HasValue == true ? Model.Filters.ReportDate.Value.ToString("yyyy-MM-dd") : DateTimeHelper.Now.ToString("yyyy-MM-dd"))"
                                   class="form-control" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-semibold" for="measuringUnitComboBox">
                                <i class="fa fa-ruler me-1 text-primary"></i>Display unit
                            </label>
                            <input id="measuringUnitComboBox" style="width: 100%;" autocomplete="off" />
                            <span class="text-muted small">Same as Stock screen; quantities convert to this unit.</span>
                        </div>
                        <div class="col-md-3 d-flex align-items-end">
                            <div class="d-flex gap-2 w-100">
                                <button type="submit" class="btn btn-primary flex-fill">
                                    <i class="fa fa-search me-1"></i> Search
                                </button>
                                <a asp-action="StockAvailableBalanceReport" class="btn btn-outline-secondary flex-fill">
                                    <i class="fa fa-refresh me-1"></i> Refresh
                                </a>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>

        <p class="text-muted small mb-4">
            <i class="fa fa-info-circle me-1"></i>
            Shows current stock levels from <strong>StockMaster</strong> (total, used, and <strong>available</strong> quantity), unit price from product ranges, and stock value (available × unit price), same basis as Daily Stock Report.
            @if (!string.IsNullOrEmpty(Model.DisplayMeasuringUnitAbbreviation))
            {
                <span class="d-block mt-1">Quantities, unit price (from minimum product-range price per base unit), and stock value use display unit <strong>@Model.DisplayMeasuringUnitAbbreviation</strong> — unit price and value are converted with the same factors as quantities.</span>
            }
        </p>

        <div class="row mb-4">
            <div class="col-md-4">
                <div class="card bg-success text-white border-success">
                    <div class="card-body">
                        <h6 class="card-title">Available quantity (as of date)</h6>
                        <h3 class="mb-0">@Model.TotalAvailableQuantity.ToString("N2")</h3>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card bg-info text-white">
                    <div class="card-body">
                        <h6 class="card-title">Total quantity (current)</h6>
                        <h3 class="mb-0">@Model.TotalQuantity.ToString("N2")</h3>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card bg-warning text-white">
                    <div class="card-body">
                        <h6 class="card-title">Used quantity (current)</h6>
                        <h3 class="mb-0">@Model.TotalUsedQuantity.ToString("N2")</h3>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card bg-primary text-white">
                    <div class="card-body">
                        <h6 class="card-title">Stock value (available × price)</h6>
                        <h3 class="mb-0">@Model.TotalStockValue.ToString("N2")</h3>
                    </div>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">
                    <i class="fa fa-table me-2"></i>Stock available balance
                </h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive" id="printArea">
                    <table class="table table-hover table-striped mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th><i class="fa fa-hashtag me-1"></i>Product Name</th>
                                <th><i class="fa fa-language me-1"></i>Urdu Name</th>
                                <th><i class="fa fa-barcode me-1"></i>Product Code</th>
                                <th><i class="fa fa-cubes me-1"></i>Total Qty@(string.IsNullOrEmpty(Model.DisplayMeasuringUnitAbbreviation) ? "" : $" ({Model.DisplayMeasuringUnitAbbreviation})")</th>
                                <th><i class="fa fa-shopping-cart me-1"></i>Used Qty@(string.IsNullOrEmpty(Model.DisplayMeasuringUnitAbbreviation) ? "" : $" ({Model.DisplayMeasuringUnitAbbreviation})")</th>
                                <th><i class="fa fa-check-circle me-1"></i>Available@(string.IsNullOrEmpty(Model.DisplayMeasuringUnitAbbreviation) ? "" : $" ({Model.DisplayMeasuringUnitAbbreviation})")</th>
                                <th><i class="fa fa-map-marker-alt me-1"></i>Location</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.StockList != null && Model.StockList.Any())
                            {
                                @foreach (var item in Model.StockList)
                                {
                                    <tr>
                                        <td><strong>@NameDisplayHelper.EnglishNameCell(item.ProductName)</strong></td>
                                        <td class="name-urdu-display" dir="auto"><strong>@NameDisplayHelper.UrduNameCell(item.ProductUrduName)</strong></td>
                                        <td><code>@Html.DisplayFor(modelItem => item.ProductCode)</code></td>
                                        <td>@Html.DisplayFor(modelItem => item.TotalQuantity)</td>
                                        <td><span class="text-warning">@item.UsedQuantity.ToString("N2")</span></td>
                                        <td><span class="text-success fw-bold">@item.AvailableQuantity.ToString("N2")</span></td>
                                        <td>@Html.DisplayFor(modelItem => item.StockLocation)</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="7" class="text-center py-4">
                                        <div class="d-flex flex-column align-items-center">
                                            <i class="fa fa-inbox fa-3x text-muted mb-3"></i>
                                            <h5 class="text-muted">No stock data found</h5>
                                            <p class="text-muted">Try adjusting filters.</p>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="card mt-4">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                    <div class="d-flex align-items-center">
                        <i class="fa fa-info-circle me-2 text-primary"></i>
                        <span class="text-muted">
                            <strong>@Model.TotalCount</strong> total items | Showing <strong>@Model.PageSize</strong> per page
                        </span>
                    </div>
                    <div class="d-flex align-items-center gap-3">
                        <label for="pageSize" class="form-label mb-0 text-muted">Items per page:</label>
                        <select id="pageSize" class="form-select form-select-sm w-auto" onchange="changeStockAvailPageSize(this)">
                            @if (ps == 10)
                            {
                                <option value="10" selected>10</option>
                            }
                            else
                            {
                                <option value="10">10</option>
                            }
                            @if (ps == 20)
                            {
                                <option value="20" selected>20</option>
                            }
                            else
                            {
                                <option value="20">20</option>
                            }
                            @if (ps == 30)
                            {
                                <option value="30" selected>30</option>
                            }
                            else
                            {
                                <option value="30">30</option>
                            }
                        </select>
                    </div>
                </div>
                @if (Model.TotalPages > 1)
                {
                    var productId = Model.Filters?.ProductId?.ToString() ?? "";
                    var reportDate = Model.Filters?.ReportDate?.ToString("yyyy-MM-dd") ?? "";
                    var displayUnitId = Model.Filters?.DisplayMeasuringUnitId?.ToString() ?? "";
                    var queryParams = new List<string> { $"pageSize={Model.PageSize}" };
                    if (!string.IsNullOrEmpty(productId))
                        queryParams.Add($"Filters.ProductId={productId}");
                    if (!string.IsNullOrEmpty(reportDate))
                        queryParams.Add($"Filters.ReportDate={reportDate}");
                    if (!string.IsNullOrEmpty(displayUnitId))
                        queryParams.Add($"Filters.DisplayMeasuringUnitId={displayUnitId}");
                    var queryString = string.Join("&", queryParams);

                    <nav aria-label="Stock available balance pagination" class="mt-3">
                        <ul class="pagination justify-content-center mb-0">
                            <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                                <a class="page-link" href="/Report/StockAvailableBalanceReport?pageNumber=1&@queryString">First</a>
                            </li>
                            <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                                <a class="page-link" href="/Report/StockAvailableBalanceReport?pageNumber=@(Model.CurrentPage - 1)&@queryString">Previous</a>
                            </li>
                            @{
                                int startPage = Math.Max(1, Model.CurrentPage - 1);
                                int endPage = Math.Min(Model.TotalPages, startPage + 2);
                                if (endPage - startPage < 2) startPage = Math.Max(1, endPage - 2);
                            }
                            @for (int i = startPage; i <= endPage; i++)
                            {
                                <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                    <a class="page-link" href="/Report/StockAvailableBalanceReport?pageNumber=@i&@queryString">@i</a>
                                </li>
                            }
                            <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                                <a class="page-link" href="/Report/StockAvailableBalanceReport?pageNumber=@(Model.CurrentPage + 1)&@queryString">Next</a>
                            </li>
                            <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                                <a class="page-link" href="/Report/StockAvailableBalanceReport?pageNumber=@Model.TotalPages&@queryString">Last</a>
                            </li>
                        </ul>
                    </nav>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            if (typeof $.fn.kendoComboBox === "undefined") return;
            var $input = $("#productComboBox");
            if (!$input.length) return;
            var initialProductId = "@(Model.Filters?.ProductId?.ToString() ?? "")";

            $input.kendoComboBox({
                dataSource: {
                    transport: {
                        read: {
                            url: "@Url.Action("GetProducts", "Product")",
                            dataType: "json"
                        }
                    }
                },
                dataTextField: "text",
                dataValueField: "value",
                placeholder: "-- All products --",
                filter: "contains",
                suggest: true,
                minLength: 1,
                value: initialProductId
            }).data("kendoComboBox");

            if (initialProductId) {
                var combo = $input.data("kendoComboBox");
                if (combo) {
                    combo.dataSource.read().then(function () {
                        combo.value(initialProductId);
                    });
                }
            }

            var initialUnitId = "@(Model.Filters?.DisplayMeasuringUnitId?.ToString() ?? "")";
            var $unitInput = $("#measuringUnitComboBox");
            if ($unitInput.length) {
                $unitInput.kendoComboBox({
                    dataSource: {
                        transport: {
                            read: {
                                url: "/UnitConversion/GetMeasuringUnits",
                                dataType: "json"
                            }
                        }
                    },
                    dataTextField: "text",
                    dataValueField: "value",
                    placeholder: "-- Base / all units --",
                    filter: "contains",
                    suggest: true,
                    value: initialUnitId || "",
                    change: function () {
                        var v = this.value();
                        $("#displayMeasuringUnitIdHidden").val(v || "");
                    },
                    select: function (e) {
                        var dataItem = this.dataItem(e.item.index());
                        if (dataItem)
                            $("#displayMeasuringUnitIdHidden").val(dataItem.value);
                    }
                });
                if (initialUnitId) {
                    var ucombo = $unitInput.data("kendoComboBox");
                    if (ucombo) {
                        ucombo.dataSource.read().then(function () {
                            ucombo.value(initialUnitId);
                            $("#displayMeasuringUnitIdHidden").val(initialUnitId);
                        });
                    }
                }
            }
        });

        function getStockAvailParams() {
            var combo = $("#productComboBox").data("kendoComboBox");
            var fallbackInput = document.querySelector("input[name='Filters.ProductId']");
            var productId = combo ? (combo.value() || "") : (fallbackInput ? fallbackInput.value : "");
            var reportDateInput = document.querySelector("input[name='Filters.ReportDate']");
            var unitCombo = $("#measuringUnitComboBox").data("kendoComboBox");
            var hiddenUnit = document.getElementById("displayMeasuringUnitIdHidden");
            var displayMeasuringUnitId = unitCombo ? (unitCombo.value() || "") : (hiddenUnit ? hiddenUnit.value : "");
            return {
                productId: productId,
                reportDate: reportDateInput ? reportDateInput.value : '',
                displayMeasuringUnitId: displayMeasuringUnitId
            };
        }

        function changeStockAvailPageSize(select) {
            var p = getStockAvailParams();
            var u = p.displayMeasuringUnitId ? `&Filters.DisplayMeasuringUnitId=${encodeURIComponent(p.displayMeasuringUnitId)}` : "";
            var url = `/Report/StockAvailableBalanceReport?pageNumber=1&Filters.ProductId=${encodeURIComponent(p.productId)}&pageSize=${select.value}&Filters.ReportDate=${encodeURIComponent(p.reportDate)}${u}`;
            window.location.href = url;
        }

        document.getElementById("exportExcelBtn").addEventListener("click", function (e) {
            e.preventDefault();
            var p = getStockAvailParams();
            var u = p.displayMeasuringUnitId ? `&displayMeasuringUnitId=${encodeURIComponent(p.displayMeasuringUnitId)}` : "";
            var url = `/Report/ExportStockAvailableBalanceExcel?productId=${encodeURIComponent(p.productId)}&reportDate=${encodeURIComponent(p.reportDate)}${u}`;
            exportWithLoader(url, 'StockAvailableBalanceReport_export.xlsx', 'Preparing Excel export... Please wait.');
        });

        document.getElementById("exportPdfBtn").addEventListener("click", function (e) {
            e.preventDefault();
            var p = getStockAvailParams();
            var u = p.displayMeasuringUnitId ? `&displayMeasuringUnitId=${encodeURIComponent(p.displayMeasuringUnitId)}` : "";
            var url = `/Report/ExportStockAvailableBalancePdf?productId=${encodeURIComponent(p.productId)}&reportDate=${encodeURIComponent(p.reportDate)}${u}`;
            exportWithLoader(url, 'StockAvailableBalanceReport_export.pdf', 'Preparing PDF export... Please wait.');
        });
    </script>
}
