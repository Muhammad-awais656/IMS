@model IMS.Models.CustomerLedgerReportViewModel
@{
    bool isAdmin = Convert.ToBoolean(User.FindFirst("IsAdmin")?.Value);
    ViewBag.Title = "Customer Ledger Report";
}
<div class="card shadow-sm">
    <div class="card-header bg-primary text-white py-3">
        <div class="d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center">
                <i class="fa fa-user me-2"></i>
                <h4 class="mb-0">Customer Ledger Report</h4>
            </div>
            <div class="d-flex gap-2">
                <a href="#" id="exportCustomerLedgerExcelBtn" class="btn btn-warning btn-sm">
                    <i class="fa fa-file-excel text-success me-1"></i> Export Excel
                </a>
                <a href="#" id="exportCustomerLedgerPdfBtn" class="btn btn-warning btn-sm">
                    <i class="fa fa-file-pdf text-danger me-1"></i> Export PDF
                </a>
            </div>
        </div>
    </div>
    <div class="card-body p-4">
        <div class="card mb-4">
            <div class="card-header bg-light">
                <h5 class="mb-0">
                    <i class="fa fa-filter me-2 text-primary"></i>Filter Options
                </h5>
            </div>
            <div class="card-body">
                <form id="filterForm" asp-action="CustomerLedgerReport" asp-controller="Report" method="get">
                    <input type="hidden" name="Filters.CustomerId" id="customerLedgerCustomerIdHidden" value="@(Model.Filters?.CustomerId?.ToString() ?? "")" />
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">
                                <i class="fa fa-user me-1 text-primary"></i>Customer
                            </label>
                            <input id="customerLedgerCustomerSelect" style="width: 100%;" />
                            <small class="text-muted">Leave empty for all customers</small>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label fw-semibold">
                                <i class="fa fa-calendar me-1 text-primary"></i>From Date
                            </label>
                            <input type="date" name="Filters.FromDate"
                                   value="@(Model.Filters?.FromDate.HasValue == true ? Model.Filters.FromDate.Value.ToString("yyyy-MM-dd") : new DateTime(DateTimeHelper.Now.Year, DateTimeHelper.Now.Month, 1).ToString("yyyy-MM-dd"))"
                                   class="form-control" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label fw-semibold">
                                <i class="fa fa-calendar me-1 text-primary"></i>To Date
                            </label>
                            <input type="date" name="Filters.ToDate"
                                   value="@(Model.Filters?.ToDate.HasValue == true ? Model.Filters.ToDate.Value.ToString("yyyy-MM-dd") : DateTimeHelper.Now.ToString("yyyy-MM-dd"))"
                                   class="form-control" />
                        </div>
                        <div class="col-md-4 d-flex align-items-end">
                            <div class="d-flex gap-2 w-100">
                                <button type="submit" class="btn btn-primary flex-fill">
                                    <i class="fa fa-search me-1"></i> Search
                                </button>
                                <a asp-action="CustomerLedgerReport" class="btn btn-outline-secondary flex-fill">
                                    <i class="fa fa-refresh me-1"></i> Refresh
                                </a>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>

        @if (Model.LedgerList != null && Model.LedgerList.Any() && !string.IsNullOrEmpty(Model.CustomerName))
        {
            <div class="row mb-3">
                <div class="col-12">
                    <h5 class="text-primary">
                        <i class="fa fa-user me-2"></i>@Model.CustomerName
                    </h5>
                </div>
            </div>
            <div class="row mb-4">
                <div class="col-md-4">
                    <div class="card bg-danger text-white">
                        <div class="card-body py-2">
                            <h6 class="card-title mb-0">Total Debit</h6>
                            <h5 class="mb-0">@Model.TotalDebit.ToString("N2")</h5>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card bg-success text-white">
                        <div class="card-body py-2">
                            <h6 class="card-title mb-0">Total Credit</h6>
                            <h5 class="mb-0">@Model.TotalCredit.ToString("N2")</h5>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card @(Model.ClosingBalance >= 0 ? "bg-primary" : "bg-warning") text-white">
                        <div class="card-body py-2">
                            <h6 class="card-title mb-0">Closing Balance</h6>
                            <h5 class="mb-0">@(Model.ClosingBalance >= 0 ? Model.ClosingBalance.ToString("N2") : "(" + (-Model.ClosingBalance).ToString("N2") + ")")</h5>
                        </div>
                    </div>
                </div>
            </div>
        }

        <div class="card">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">
                    <i class="fa fa-table me-2"></i>Ledger
                </h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive" id="printArea">
                    <table class="table table-hover table-striped mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th><i class="fa fa-calendar me-1"></i>Date</th>
                                <th><i class="fa fa-book me-1"></i>GL Account (Customer)</th>
                                <th class="text-end"><i class="fa fa-plus-circle me-1"></i>Debit</th>
                                <th class="text-end"><i class="fa fa-minus-circle me-1"></i>Credit</th>
                                <th class="text-end"><i class="fa fa-balance-scale me-1"></i>Balance</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.LedgerList != null && Model.LedgerList.Any())
                            {
                                @foreach (var item in Model.LedgerList)
                                {
                                    <tr>
                                        <td>@item.Date.ToString("dd-MMM-yy")</td>
                                        <td>@(item.CustomerName ?? "-")</td>
                                        <td class="text-end text-danger">
                                            @(item.Debit > 0 ? item.Debit.ToString("N2") : "-")
                                        </td>
                                        <td class="text-end text-success">
                                            @(item.Credit > 0 ? item.Credit.ToString("N2") : "-")
                                        </td>
                                        <td class="text-end fw-bold" style="color: green;">
                                            @(item.Balance == 0 ? "-" : item.Balance > 0 ? item.Balance.ToString("N2") : "(" + (-item.Balance).ToString("N2") + ")")
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5" class="text-center py-4">
                                        <div class="d-flex flex-column align-items-center">
                                            <i class="fa fa-inbox fa-3x text-muted mb-3"></i>
                                            <h5 class="text-muted">No ledger data</h5>
                                            <p class="text-muted">Click Search to view the ledger (leave customer empty for all customers).</p>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            function getExportParams() {
                var customerId = document.getElementById("customerLedgerCustomerIdHidden") ? document.getElementById("customerLedgerCustomerIdHidden").value || "" : "";
                var fromInput = document.querySelector("input[name='Filters.FromDate']");
                var toInput = document.querySelector("input[name='Filters.ToDate']");
                var fromDate = fromInput ? fromInput.value || "" : "";
                var toDate = toInput ? toInput.value || "" : "";
                if (typeof $ !== 'undefined') {
                    var combo = $("#customerLedgerCustomerSelect").data("kendoComboBox");
                    if (combo) customerId = combo.value() || "";
                }
                var params = new URLSearchParams();
                if (customerId) params.append("customerId", customerId);
                if (fromDate) params.append("fromDate", fromDate);
                if (toDate) params.append("toDate", toDate);
                return params;
            }

            if (typeof $ !== 'undefined' && typeof $.fn.kendoComboBox !== 'undefined') {
                var $select = $("#customerLedgerCustomerSelect");
                if ($select.length) {
                    var existingCombo = $select.data("kendoComboBox");
                    if (existingCombo) existingCombo.destroy();
                    $select.kendoComboBox({
                        placeholder: "All Customers",
                        filter: "contains",
                        suggest: true,
                        minLength: 1,
                        dataTextField: "text",
                        dataValueField: "value",
                        dataSource: {
                            transport: {
                                read: {
                                    url: "@Url.Action("GetCustomersForDropdown", "Customer")",
                                    dataType: "json"
                                }
                            }
                        },
                        value: "@(Model.Filters?.CustomerId?.ToString() ?? "")",
                        change: function () {
                            var val = this.value();
                            $("#customerLedgerCustomerIdHidden").val(val || "");
                        }
                    });
                    $("#filterForm").on("submit", function () {
                        var combo = $("#customerLedgerCustomerSelect").data("kendoComboBox");
                        if (combo) $("#customerLedgerCustomerIdHidden").val(combo.value() || "");
                    });
                }
            }

            var excelBtn = document.getElementById("exportCustomerLedgerExcelBtn");
            if (excelBtn) {
                excelBtn.addEventListener("click", function (e) {
                    e.preventDefault();
                    var params = getExportParams();
                    var url = "@Url.Action("ExportCustomerLedgerExcel", "Report")" + (params.toString() ? "?" + params.toString() : "");
                    if (typeof exportWithLoader === "function")
                        exportWithLoader(url, "CustomerLedgerReport_export.xlsx", "Preparing Excel export... Please wait.");
                    else
                        window.location.href = url;
                });
            }
            var pdfBtn = document.getElementById("exportCustomerLedgerPdfBtn");
            if (pdfBtn) {
                pdfBtn.addEventListener("click", function (e) {
                    e.preventDefault();
                    var params = getExportParams();
                    var url = "@Url.Action("ExportCustomerLedgerPdf", "Report")" + (params.toString() ? "?" + params.toString() : "");
                    if (typeof exportWithLoader === "function")
                        exportWithLoader(url, "CustomerLedgerReport_export.pdf", "Preparing PDF export... Please wait.");
                    else
                        window.location.href = url;
                });
            }
        });
    </script>
}
