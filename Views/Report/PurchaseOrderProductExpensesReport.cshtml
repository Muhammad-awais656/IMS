        function updateReportTitle(expenseTypeText, productId) {
            if (expenseTypeText === "Direct Product Expense" && productId && productId !== '') {
                $("#reportTitle").text("Direct Product Expense Report");
            } else {
                $("#reportTitle").text("General Expenses Report");
            }
        }

        function clearDate(fieldName) {
            var input = document.querySelector(`input[name='${fieldName}']`);
            if (input) {
                input.value = '';
                // Submit form to apply cleared date
                document.getElementById('filterForm').submit();
            }
        }

        function changePageSize(select) {
            var expenseTypeCombo = $("#expenseTypeComboBox").data("kendoComboBox");
            var expenseTypeId = expenseTypeCombo ? expenseTypeCombo.value() : "";
            var productCombo = $("#productComboBox").data("kendoComboBox");
            var productId = productCombo ? productCombo.value() : "";
            var fromDateInput = document.querySelector("input[name='Filters.FromDate']");
            var toDateInput = document.querySelector("input[name='Filters.ToDate']");
            var fromDate = fromDateInput ? fromDateInput.value : "";
            var toDate = toDateInput ? toDateInput.value : "";

            var url = `/Report/PurchaseOrderProductExpensesReport?pageNumber=1&pageSize=${select.value}`;
            if (expenseTypeId) {
                url += `&Filters.ExpenseTypeId=${expenseTypeId}`;
            }
            if (productId) {
                url += `&Filters.ProductId=${productId}`;
            }
            if (fromDate) {
                url += `&Filters.FromDate=${fromDate}`;
            }
            if (toDate) {
                url += `&Filters.ToDate=${toDate}`;
            }
            window.location.href = url;
        }
    </script>
    <script>
        document.getElementById("exportExcelBtn").addEventListener("click", function () {
