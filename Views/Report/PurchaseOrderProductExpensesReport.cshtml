            var fromDate = document.querySelector("input[name='Filters.FromDate']").value;
            var toDate = document.querySelector("input[name='Filters.ToDate']").value;

            var url = `/Report/ExportPOExpensesExcel?productId=${productId}&FromDate=${fromDate}&ToDate=${toDate}`;
            window.location.href = url;
        });

        document.getElementById("exportPdfBtn").addEventListener("click", function () {
            var productCombo = $("#productComboBox").data("kendoComboBox");
            var productId = productCombo ? productCombo.value() : "";
            var fromDate = document.querySelector("input[name='Filters.FromDate']").value;
            var toDate = document.querySelector("input[name='Filters.ToDate']").value;

            var url = `/Report/ExportPOExpensesPdf?productId=${productId}&FromDate=${fromDate}&ToDate=${toDate}`;
            window.location.href = url;
        });
    </script>
}

