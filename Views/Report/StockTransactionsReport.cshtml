@model IMS.Models.StockTransactionsReportViewModel
@{
    var ttid = Model.Filters?.TransactionTypeId;
}
<div class="card shadow-sm">
    <div class="card-header bg-primary text-white py-3">
        <div class="d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center">
                <i class="fa fa-right-left me-2"></i>
                <h4 class="mb-0">Stock Transactions Report</h4>
            </div>
            <div class="d-flex gap-2">
                <a href="#" id="exportExcelBtn" class="btn btn-warning btn-sm">
                    <i class="fa fa-file-excel text-success me-1"></i> Export Excel
                </a>
                <a href="#" id="exportPdfBtn" class="btn btn-warning btn-sm">
                    <i class="fa fa-file-pdf text-danger me-1"></i> Export PDF
                </a>
            </div>
        </div>
    </div>
    <div class="card-body p-4">
        <div class="card mb-4">
            <div class="card-header bg-light">
                <h5 class="mb-0">
                    <i class="fa fa-filter me-2 text-primary"></i>Filter Options
                </h5>
            </div>
            <div class="card-body">
                <form id="filterForm" asp-action="StockTransactionsReport" asp-controller="Report" method="get">
                    <div class="row g-3">
                        <div class="col-md-3">
                            <label class="form-label fw-semibold" for="productComboBox">
                                <i class="fa fa-gift me-1 text-primary"></i>Product
                            </label>
                            <input id="productComboBox" name="Filters.ProductId"
                                   value="@(Model.Filters?.ProductId?.ToString() ?? "")"
                                   style="width: 100%;"
                                   autocomplete="off" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label fw-semibold">
                                <i class="fa fa-calendar me-1 text-primary"></i>From Date
                            </label>
                            <div class="input-group">
                                <input type="date" name="Filters.FromDate"
                                       value="@(Model.Filters?.FromDate.HasValue == true ? Model.Filters.FromDate.Value.ToString("yyyy-MM-dd") : new DateTime(DateTimeHelper.Now.Year, DateTimeHelper.Now.Month, 1).ToString("yyyy-MM-dd"))"
                                       class="form-control" />
                                <button type="button" class="btn btn-outline-secondary" onclick="clearDate('Filters.FromDate')" title="Clear Date">
                                    <i class="fa fa-times"></i>
                                </button>
                            </div>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label fw-semibold">
                                <i class="fa fa-calendar me-1 text-primary"></i>To Date
                            </label>
                            <div class="input-group">
                                <input type="date" name="Filters.ToDate"
                                       value="@(Model.Filters?.ToDate.HasValue == true ? Model.Filters.ToDate.Value.ToString("yyyy-MM-dd") : DateTimeHelper.Now.ToString("yyyy-MM-dd"))"
                                       class="form-control" />
                                <button type="button" class="btn btn-outline-secondary" onclick="clearDate('Filters.ToDate')" title="Clear Date">
                                    <i class="fa fa-times"></i>
                                </button>
                            </div>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label fw-semibold" for="stockTxnTypeSelect">
                                <i class="fa fa-exchange-alt me-1 text-primary"></i>Transaction Type
                            </label>
                            <select id="stockTxnTypeSelect" name="Filters.TransactionTypeId" class="form-select">
                                @if (!ttid.HasValue || ttid == 0)
                                {
                                    <option value="" selected>All Types</option>
                                }
                                else
                                {
                                    <option value="">All Types</option>
                                }
                                @if (ttid == 1)
                                {
                                    <option value="1" selected>Added</option>
                                }
                                else
                                {
                                    <option value="1">Added</option>
                                }
                                @if (ttid == 2)
                                {
                                    <option value="2" selected>Sale</option>
                                }
                                else
                                {
                                    <option value="2">Sale</option>
                                }
                                @if (ttid == 3)
                                {
                                    <option value="3" selected>Purchase</option>
                                }
                                else
                                {
                                    <option value="3">Purchase</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-3 d-flex align-items-end">
                            <div class="d-flex gap-2 w-100">
                                <button type="submit" class="btn btn-primary flex-fill">
                                    <i class="fa fa-search me-1"></i> Search
                                </button>
                                <a asp-action="StockTransactionsReport" class="btn btn-outline-secondary flex-fill">
                                    <i class="fa fa-refresh me-1"></i> Refresh
                                </a>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>

        <p class="text-muted small mb-3">
            <i class="fa fa-info-circle me-1"></i>
            Same transaction lines as <strong>Stock → Transaction History</strong> (per product / stock master). Choose a product, optional dates and type, then Search.
        </p>

        @if (Model.Filters?.ProductId > 0 && !string.IsNullOrEmpty(Model.ProductName))
        {
            <div class="row mb-3">
                <div class="col-md-6">
                    <div class="card border-primary">
                        <div class="card-body py-2">
                            <strong>Product:</strong> @NameDisplayHelper.EnglishNameCell(Model.ProductName)
                            @if (!string.IsNullOrEmpty(Model.ProductCode))
                            {
                                <code class="ms-2">@Model.ProductCode</code>
                            }
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card bg-light">
                        <div class="card-body py-2">
                            <small class="text-muted">Available qty</small>
                            <div class="fw-bold">@(Model.AvailableQuantity?.ToString("N4") ?? "—")</div>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card bg-light">
                        <div class="card-body py-2">
                            <small class="text-muted">Matching transactions</small>
                            <div class="fw-bold">@Model.TotalCount</div>
                        </div>
                    </div>
                </div>
            </div>
        }
        else if (Model.Filters?.ProductId == null || Model.Filters.ProductId <= 0)
        {
            <div class="alert alert-info mb-3">
                Select a <strong>product</strong> to load stock transactions.
            </div>
        }

        <div class="card">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0"><i class="fa fa-table me-2"></i>Transactions</h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover table-striped mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th>Transaction ID</th>
                                <th class="text-end">Quantity</th>
                                <th>Date</th>
                                <th>Transaction Type</th>
                                <th>Description</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.TransactionList != null && Model.TransactionList.Any())
                            {
                                @foreach (var t in Model.TransactionList)
                                {
                                    <tr>
                                        <td><span class="badge bg-secondary">@t.StockTransactionId</span></td>
                                        <td class="text-end fw-semibold @(t.StockQuantity >= 0 ? "text-success" : "text-danger")">@t.StockQuantity.ToString("N4")</td>
                                        <td>@t.TransactionDate.ToString("dd-MMM-yyyy HH:mm")</td>
                                        <td><span class="badge bg-info">@t.TransactionType</span></td>
                                        <td>@(string.IsNullOrEmpty(t.Description) ? "—" : t.Description)</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5" class="text-center py-4 text-muted">No transactions for the selected filters.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        @if (Model.Filters?.ProductId > 0)
        {
            var pid = Model.Filters.ProductId.ToString();
            var fromDate = Model.Filters.FromDate?.ToString("yyyy-MM-dd") ?? "";
            var toDate = Model.Filters.ToDate?.ToString("yyyy-MM-dd") ?? "";
            var tt = Model.Filters.TransactionTypeId.HasValue && Model.Filters.TransactionTypeId.Value > 0
                ? Model.Filters.TransactionTypeId.Value.ToString()
                : "";
            var queryParams = new List<string> { $"pageSize={Model.PageSize}" };
            queryParams.Add($"Filters.ProductId={pid}");
            if (!string.IsNullOrEmpty(fromDate)) queryParams.Add($"Filters.FromDate={fromDate}");
            if (!string.IsNullOrEmpty(toDate)) queryParams.Add($"Filters.ToDate={toDate}");
            if (!string.IsNullOrEmpty(tt)) queryParams.Add($"Filters.TransactionTypeId={tt}");
            var queryString = string.Join("&", queryParams);
            var pageSizeVal = Model.PageSize ?? 10;

            <div class="card mt-4">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                        <div class="d-flex align-items-center">
                            <i class="fa fa-info-circle me-2 text-primary"></i>
                            <span class="text-muted">
                                <strong>@Model.TotalCount</strong> total | Page <strong>@Model.CurrentPage</strong> of <strong>@Model.TotalPages</strong>
                            </span>
                        </div>
                        <div class="d-flex align-items-center gap-3">
                            <label for="pageSize" class="form-label mb-0 text-muted">Per page:</label>
                            <select id="pageSize" class="form-select form-select-sm w-auto" onchange="changeStockTxnPageSize(this)">
                                @if (pageSizeVal == 10)
                                {
                                    <option value="10" selected>10</option>
                                }
                                else
                                {
                                    <option value="10">10</option>
                                }
                                @if (pageSizeVal == 20)
                                {
                                    <option value="20" selected>20</option>
                                }
                                else
                                {
                                    <option value="20">20</option>
                                }
                                @if (pageSizeVal == 30)
                                {
                                    <option value="30" selected>30</option>
                                }
                                else
                                {
                                    <option value="30">30</option>
                                }
                            </select>
                        </div>
                    </div>
                    @if (Model.TotalPages > 1)
                    {
                        <nav aria-label="Stock transactions pagination" class="mt-3">
                            <ul class="pagination justify-content-center mb-0">
                                <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                                    <a class="page-link" href="/Report/StockTransactionsReport?pageNumber=1&@queryString">First</a>
                                </li>
                                <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                                    <a class="page-link" href="/Report/StockTransactionsReport?pageNumber=@(Model.CurrentPage - 1)&@queryString">Previous</a>
                                </li>
                                @{
                                    int startPage = Math.Max(1, Model.CurrentPage - 1);
                                    int endPage = Math.Min(Model.TotalPages, startPage + 2);
                                    if (endPage - startPage < 2) startPage = Math.Max(1, endPage - 2);
                                }
                                @for (int i = startPage; i <= endPage; i++)
                                {
                                    <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                        <a class="page-link" href="/Report/StockTransactionsReport?pageNumber=@i&@queryString">@i</a>
                                    </li>
                                }
                                <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                                    <a class="page-link" href="/Report/StockTransactionsReport?pageNumber=@(Model.CurrentPage + 1)&@queryString">Next</a>
                                </li>
                                <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                                    <a class="page-link" href="/Report/StockTransactionsReport?pageNumber=@Model.TotalPages&@queryString">Last</a>
                                </li>
                            </ul>
                        </nav>
                    }
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        function clearDate(fieldName) {
            var input = document.querySelector(`input[name='${fieldName}']`);
            if (input) {
                input.value = '';
                document.getElementById('filterForm').submit();
            }
        }

        $(document).ready(function () {
            if (typeof $.fn.kendoComboBox === "undefined") return;
            var $input = $("#productComboBox");
            if (!$input.length) return;
            var initialProductId = "@(Model.Filters?.ProductId?.ToString() ?? "")";

            $input.kendoComboBox({
                dataSource: {
                    transport: {
                        read: {
                            url: "@Url.Action("GetProducts", "Product")",
                            dataType: "json"
                        }
                    }
                },
                dataTextField: "text",
                dataValueField: "value",
                placeholder: "-- Select Product --",
                filter: "contains",
                suggest: true,
                minLength: 1,
                value: initialProductId
            }).data("kendoComboBox");

            if (initialProductId) {
                var combo = $input.data("kendoComboBox");
                if (combo) {
                    combo.dataSource.read().then(function () {
                        combo.value(initialProductId);
                    });
                }
            }
        });

        function getStockTxnParams() {
            var combo = $("#productComboBox").data("kendoComboBox");
            var fallbackInput = document.querySelector("input[name='Filters.ProductId']");
            var productId = combo ? (combo.value() || "") : (fallbackInput ? fallbackInput.value : "");
            var fromDate = document.querySelector("input[name='Filters.FromDate']");
            var toDate = document.querySelector("input[name='Filters.ToDate']");
            var tt = document.getElementById("stockTxnTypeSelect");
            return {
                productId: productId,
                fromDate: fromDate ? fromDate.value : '',
                toDate: toDate ? toDate.value : '',
                transactionTypeId: tt ? tt.value : ''
            };
        }

        function changeStockTxnPageSize(select) {
            var p = getStockTxnParams();
            var url = `/Report/StockTransactionsReport?pageNumber=1&Filters.ProductId=${encodeURIComponent(p.productId)}&pageSize=${select.value}&Filters.FromDate=${encodeURIComponent(p.fromDate)}&Filters.ToDate=${encodeURIComponent(p.toDate)}`;
            if (p.transactionTypeId) url += `&Filters.TransactionTypeId=${encodeURIComponent(p.transactionTypeId)}`;
            window.location.href = url;
        }

        document.getElementById("exportExcelBtn").addEventListener("click", function (e) {
            e.preventDefault();
            var p = getStockTxnParams();
            if (!p.productId) {
                alert("Please select a product.");
                return;
            }
            var url = `/Report/ExportStockTransactionsExcel?productId=${encodeURIComponent(p.productId)}&fromDate=${encodeURIComponent(p.fromDate)}&toDate=${encodeURIComponent(p.toDate)}&transactionTypeId=${encodeURIComponent(p.transactionTypeId)}`;
            exportWithLoader(url, 'StockTransactionsReport_export.xlsx', 'Preparing Excel export... Please wait.');
        });

        document.getElementById("exportPdfBtn").addEventListener("click", function (e) {
            e.preventDefault();
            var p = getStockTxnParams();
            if (!p.productId) {
                alert("Please select a product.");
                return;
            }
            var url = `/Report/ExportStockTransactionsPdf?productId=${encodeURIComponent(p.productId)}&fromDate=${encodeURIComponent(p.fromDate)}&toDate=${encodeURIComponent(p.toDate)}&transactionTypeId=${encodeURIComponent(p.transactionTypeId)}`;
            exportWithLoader(url, 'StockTransactionsReport_export.pdf', 'Preparing PDF export... Please wait.');
        });
    </script>
}
