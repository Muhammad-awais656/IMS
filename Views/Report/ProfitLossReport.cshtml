@model IMS.Models.ProfitLossReportViewModel;
@using IMS.Models
@{
    bool isAdmin = Convert.ToBoolean(User.FindFirst("IsAdmin")?.Value);
    string role = isAdmin ? "Admin" : "User";
    var isOverall = Model.Filters?.ViewMode == ProfitLossReportViewMode.Overall;
    var viewModeVal = (int)(Model.Filters?.ViewMode ?? ProfitLossReportViewMode.ProductWise);
}
<div class="card shadow-sm">
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger m-3 mb-0" role="alert">
            <i class="fa fa-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
        </div>
    }
    <div class="card-header bg-primary text-white py-3">
        <div class="d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center">
                <i class="fa fa-chart-bar me-2"></i>
                <h4 class="mb-0">@(isOverall ? "Overall Profit and Loss Report" : "Product Wise Profit and Loss Report")</h4>
            </div>
            <div class="d-flex gap-2">
                <a href="#" id="exportExcelBtn" class="btn btn-warning btn-sm">
                    <i class="fa fa-file-excel text-success me-1"></i> Export Excel
                </a>
                <a href="#" id="exportPdfBtn" class="btn btn-warning btn-sm">
                    <i class="fa fa-file-pdf text-danger me-1"></i> Export PDF
                </a>
            </div>
        </div>
    </div>
    <div class="card-body p-4">
        <!-- Enhanced Filter Section -->
        <div class="card mb-4">
            <div class="card-header bg-light">
                <h5 class="mb-0">
                    <i class="fa fa-filter me-2 text-primary"></i>Filter Options
                </h5>
            </div>
            <div class="card-body">
                <form id="filterForm" asp-action="ProfitLossReport" asp-controller="Report" method="get">
                    <div class="row g-3">
                        <div class="col-md-3 col-lg-2">
                            <label class="form-label fw-semibold" for="productComboBox">
                                <i class="fa fa-gift me-1 text-primary"></i>Product
                            </label>
                            <input id="productComboBox" name="Filters.ProductId"
                                   value="@(Model.Filters?.ProductId?.ToString() ?? "")"
                                   style="width: 100%;"
                                   autocomplete="off" />
                        </div>
                        <div class="col-md-3 col-lg-2">
                            <label class="form-label fw-semibold" for="viewModeSelect">
                                <i class="fa fa-layer-group me-1 text-primary"></i>Report type
                            </label>
                            <select id="viewModeSelect" name="Filters.ViewMode" class="form-select">
                                @if (viewModeVal == 0)
                                {
                                    <option value="0" selected>Product wise (detail)</option>
                                    <option value="1">Overall profit / loss</option>
                                }
                                else
                                {
                                    <option value="0">Product wise (detail)</option>
                                    <option value="1" selected>Overall profit / loss</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-3 col-lg-3">
                            <label class="form-label fw-semibold">
                                <i class="fa fa-calendar me-1 text-primary"></i>From Date
                            </label>
                            <div class="input-group">
                                <input type="date" name="Filters.FromDate"
                                       value="@(Model.Filters?.FromDate.HasValue == true ? Model.Filters.FromDate.Value.ToString("yyyy-MM-dd") : new DateTime(DateTimeHelper.Now.Year, DateTimeHelper.Now.Month, 1).ToString("yyyy-MM-dd"))"
                                       class="form-control" />
                                <button type="button" class="btn btn-outline-secondary" onclick="clearDate('Filters.FromDate')" title="Clear Date">
                                    <i class="fa fa-times"></i>
                                </button>
                            </div>
                        </div>
                        <div class="col-md-3 col-lg-3">
                            <label class="form-label fw-semibold">
                                <i class="fa fa-calendar me-1 text-primary"></i>To Date
                            </label>
                            <div class="input-group">
                                <input type="date" name="Filters.ToDate"
                                       value="@(Model.Filters?.ToDate.HasValue == true ? Model.Filters.ToDate.Value.ToString("yyyy-MM-dd") : DateTimeHelper.Now.ToString("yyyy-MM-dd"))"
                                       class="form-control" />
                                <button type="button" class="btn btn-outline-secondary" onclick="clearDate('Filters.ToDate')" title="Clear Date">
                                    <i class="fa fa-times"></i>
                                </button>
                            </div>
                        </div>
                        <div class="col-md-12 col-lg-2 d-flex align-items-end">
                            <div class="d-flex gap-2 w-100">
                                <button type="submit" class="btn btn-primary flex-fill">
                                    <i class="fa fa-search me-1"></i> Search
                                </button>
                                <a asp-action="ProfitLossReport" class="btn btn-outline-secondary flex-fill">
                                    <i class="fa fa-refresh me-1"></i> Refresh
                                </a>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>

        <!-- Summary Cards -->
        @if (isOverall && Model.TotalCount > 0)
        {
            <p class="text-muted small mb-2">
                <i class="fa fa-info-circle me-1"></i>Grand totals and the table below include <strong>@Model.TotalCount</strong> product(s) for the selected dates@(Model.Filters?.ProductId.HasValue == true ? " (filtered by product)" : "").
            </p>
        }
        <div class="row mb-4">
            <div class="col-md-4">
                <div class="card bg-success text-white">
                    <div class="card-body">
                        <h6 class="card-title">Total Sales Amount</h6>
                        <h3 class="mb-0">@Model.TotalSalesAmount.ToString("N2")</h3>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card bg-info text-white">
                    <div class="card-body">
                        <h6 class="card-title">Total stock amount</h6>
                        <h3 class="mb-0">@Model.TotalPurchaseCost.ToString("N2")</h3>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card @(Model.TotalProfitLoss >= 0 ? "bg-primary" : "bg-danger") text-white">
                    <div class="card-body">
                        <h6 class="card-title">Total Profit/Loss</h6>
                        <h3 class="mb-0">@Model.TotalProfitLoss.ToString("N2")</h3>
                    </div>
                </div>
            </div>
        </div>

        <!-- Spreadsheet-style blocks per product, or overall summary table -->
        <div class="card">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">
                    <i class="fa fa-table me-2"></i>@(isOverall ? "Overall profit / loss (all products)" : "Product wise profit and loss (detail)")
                </h5>
            </div>
            <div class="card-body" id="printArea">
                @if (isOverall && Model.ProfitLossList != null && Model.ProfitLossList.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-sm table-bordered table-hover align-middle mb-0">
                            <thead class="table-secondary">
                                <tr>
                                    <th>Product</th>
                                    <th class="text-end">Sale amount</th>
                                    <th class="text-end">Total stock amount</th>
                                    <th class="text-end">Profit / (loss)</th>
                                    <th class="text-end">%</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in Model.ProfitLossList)
                                {
                                    <tr>
                                        <td>
                                            <strong>@NameDisplayHelper.EnglishNameCell(row.ProductName)</strong>
                                            @if (!string.IsNullOrWhiteSpace(row.ProductUrduName))
                                            {
                                                <span class="name-urdu-display text-secondary ms-1" dir="auto">@NameDisplayHelper.UrduNameCell(row.ProductUrduName)</span>
                                            }
                                        </td>
                                        <td class="text-end">@row.TotalSalesAmount.ToString("N2")</td>
                                        <td class="text-end">@row.TotalPurchaseCost.ToString("N2")</td>
                                        <td class="text-end @(row.ProfitLoss >= 0 ? "text-success" : "text-danger") fw-semibold">@row.ProfitLoss.ToString("N2")</td>
                                        <td class="text-end">@row.ProfitLossPercentage.ToString("N2")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else if (!isOverall && Model.ProductDetailSections != null && Model.ProductDetailSections.Any())
                {
                    @foreach (var p in Model.ProductDetailSections)
                    {
                        <div class="mb-4 pnl-product-block border rounded overflow-hidden">
                            <div class="bg-light px-3 py-2 border-bottom">
                                <strong>@NameDisplayHelper.EnglishNameCell(p.ProductName)</strong>
                                @if (!string.IsNullOrWhiteSpace(p.ProductUrduName))
                                {
                                    <span class="name-urdu-display text-secondary ms-2" dir="auto">@NameDisplayHelper.UrduNameCell(p.ProductUrduName)</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(p.ProductCode))
                                {
                                    <code class="ms-2">@p.ProductCode</code>
                                }
                            </div>
                            <div class="table-responsive">
                                <table class="table table-sm table-bordered mb-0 align-middle">
                                    <thead class="table-secondary">
                                        <tr>
                                            <th style="width:28%">Description</th>
                                            <th class="text-end">Weight</th>
                                            <th class="text-end">Amount</th>
                                            <th class="text-end">Rate</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr>
                                            <td>Previous</td>
                                            <td class="text-end">@p.PreviousWeight.ToString("N2")</td>
                                            <td class="text-end">@p.PreviousAmount.ToString("N2")</td>
                                            <td class="text-end">@p.PreviousRate.ToString("N2")</td>
                                        </tr>
                                        <tr>
                                            <td>Purchase</td>
                                            <td class="text-end">@p.PurchaseWeight.ToString("N2")</td>
                                            <td class="text-end">@p.PurchaseAmount.ToString("N2")</td>
                                            <td class="text-end">@p.PurchaseRate.ToString("N2")</td>
                                        </tr>
                                        <tr>
                                            <td>Purchase Exp</td>
                                            <td class="text-end">—</td>
                                            <td class="text-end">@(p.PurchaseExpenseAmount != 0 ? p.PurchaseExpenseAmount.ToString("N2") : "")</td>
                                            <td class="text-end">—</td>
                                        </tr>
                                        <tr class="fw-bold">
                                            <td>Total Stock</td>
                                            <td class="text-end">@p.TotalStockWeight.ToString("N2")</td>
                                            <td class="text-end">@p.TotalStockAmount.ToString("N2")</td>
                                            <td class="text-end">@p.TotalStockRate.ToString("N2")</td>
                                        </tr>
                                        <tr>
                                            <td>Sale</td>
                                            <td class="text-end">@p.SaleWeight.ToString("N2")</td>
                                            <td class="text-end">@p.SaleAmount.ToString("N2")</td>
                                            <td class="text-end">@p.SaleRate.ToString("N2")</td>
                                        </tr>
                                        <tr class="fw-bold">
                                            <td>Balance Stock</td>
                                            <td class="text-end">@p.BalanceStockWeight.ToString("N2")</td>
                                            <td class="text-end">@p.BalanceStockAmount.ToString("N2")</td>
                                            <td class="text-end">@p.BalanceRate.ToString("N2")</td>
                                        </tr>
                                        @if (p.BagsWeight != 0 || p.BagsRate != 0)
                                        {
                                            <tr>
                                                <td>Bags</td>
                                                <td class="text-end">@p.BagsWeight.ToString("N2")</td>
                                                <td class="text-end">@p.BagsAmount.ToString("N2")</td>
                                                <td class="text-end fw-bold">@p.BagsRate.ToString("N2")</td>
                                            </tr>
                                        }
                                        <tr class="table-dark text-white">
                                            <td>Profit</td>
                                            <td class="text-end">—</td>
                                            <td class="text-end fw-bold">@p.Profit.ToString("N2")</td>
                                            <td class="text-end">—</td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="text-center py-5 text-muted">
                        <i class="fa fa-inbox fa-3x mb-3 d-block"></i>
                        <h5>No Profit/Loss Data Found</h5>
                        <p class="mb-0">Try adjusting your filter criteria to see more results.</p>
                    </div>
                }
            </div>
        </div>
        @if (!isOverall)
        {
        <!-- Enhanced Pagination Section -->
        <div class="card mt-4">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                    <div class="d-flex align-items-center">
                        <i class="fa fa-info-circle me-2 text-primary"></i>
                        <span class="text-muted">
                            <strong>@Model.TotalCount</strong> total items | Showing <strong>@Model.PageSize</strong> items per page
                        </span>
                    </div>
                    <div class="d-flex align-items-center gap-3">
                        <label for="pageSize" class="form-label mb-0 text-muted">
                            <i class="fa fa-list me-1"></i>Items Per Page:
                        </label>
                        @{
                            var curPageSize = Model.PageSize ?? 10;
                        }
                        <select id="pageSize" class="form-select form-select-sm w-auto" onchange="changePageSize(this)">
                            @if (curPageSize == 10)
                            {
                                <option value="10" selected>10</option>
                            }
                            else
                            {
                                <option value="10">10</option>
                            }
                            @if (curPageSize == 20)
                            {
                                <option value="20" selected>20</option>
                            }
                            else
                            {
                                <option value="20">20</option>
                            }
                            @if (curPageSize == 30)
                            {
                                <option value="30" selected>30</option>
                            }
                            else
                            {
                                <option value="30">30</option>
                            }
                        </select>
                    </div>
                </div>
                @if (Model.TotalPages > 1)
                {
                    var productId = Model.Filters?.ProductId?.ToString() ?? "";
                    var fromDate = Model.Filters?.FromDate?.ToString("yyyy-MM-dd") ?? "";
                    var toDate = Model.Filters?.ToDate?.ToString("yyyy-MM-dd") ?? "";
                    
                    // Build query string parameters
                    var queryParams = new List<string>
                    {
                        $"pageSize={Model.PageSize}"
                    };
                    
                    if (!string.IsNullOrEmpty(productId))
                        queryParams.Add($"Filters.ProductId={productId}");
                    if (!string.IsNullOrEmpty(fromDate))
                        queryParams.Add($"Filters.FromDate={fromDate}");
                    if (!string.IsNullOrEmpty(toDate))
                        queryParams.Add($"Filters.ToDate={toDate}");
                    queryParams.Add($"Filters.ViewMode={viewModeVal}");
                    
                    var queryString = string.Join("&", queryParams);
                    
                    <nav aria-label="Product Wise Profit and Loss Report pagination" class="mt-3">
                        <ul class="pagination justify-content-center mb-0">
                            <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                                <a class="page-link" href="/Report/ProfitLossReport?pageNumber=1&@queryString">
                                    <i class="fa fa-angle-double-left me-1"></i>First
                                </a>
                            </li>
                            <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                                <a class="page-link" href="/Report/ProfitLossReport?pageNumber=@(Model.CurrentPage - 1)&@queryString">
                                    <i class="fa fa-angle-left me-1"></i>Previous
                                </a>
                            </li>
                            @{
                                int startPage = Math.Max(1, Model.CurrentPage - 1);
                                int endPage = Math.Min(Model.TotalPages, startPage + 2);
                                if (endPage - startPage < 2)
                                {
                                    startPage = Math.Max(1, endPage - 2);
                                }
                            }
                            @for (int i = startPage; i <= endPage; i++)
                            {
                                <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                    <a class="page-link" href="/Report/ProfitLossReport?pageNumber=@i&@queryString">@i</a>
                                </li>
                            }
                            <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                                <a class="page-link" href="/Report/ProfitLossReport?pageNumber=@(Model.CurrentPage + 1)&@queryString">
                                    Next<i class="fa fa-angle-right ms-1"></i>
                                </a>
                            </li>
                            <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                                <a class="page-link" href="/Report/ProfitLossReport?pageNumber=@Model.TotalPages&@queryString">
                                    Last<i class="fa fa-angle-double-right ms-1"></i>
                                </a>
                            </li>
                        </ul>
                    </nav>
                }
            </div>
        </div>
        }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function clearDate(fieldName) {
            var input = document.querySelector(`input[name='${fieldName}']`);
            if (input) {
                input.value = '';
                document.getElementById('filterForm').submit();
            }
        }
        $(document).ready(function() {
            if (typeof $.fn.kendoComboBox === "undefined") {
                return;
            }
            var $input = $("#productComboBox");
            if (!$input.length) {
                return;
            }
            var initialProductId = "@(Model.Filters?.ProductId?.ToString() ?? "")";

            var productCombo = $input.kendoComboBox({
                dataSource: {
                    transport: {
                        read: {
                            url: "@Url.Action("GetProducts", "Product")",
                            dataType: "json"
                        }
                    }
                },
                dataTextField: "text",
                dataValueField: "value",
                placeholder: "-- Select Product --",
                filter: "contains",
                suggest: true,
                minLength: 1,
                value: initialProductId
            }).data("kendoComboBox");

            if (initialProductId && productCombo) {
                productCombo.dataSource.read().then(function () {
                    productCombo.value(initialProductId);
                });
            }
        });

        function getProfitLossParams() {
            var combo = $("#productComboBox").data("kendoComboBox");
            var fallbackInput = document.querySelector("input[name='Filters.ProductId']");
            var productId = combo ? (combo.value() || "") : (fallbackInput ? fallbackInput.value : "");
            var fromDateInput = document.querySelector("input[name='Filters.FromDate']");
            var toDateInput = document.querySelector("input[name='Filters.ToDate']");
            var viewModeInput = document.querySelector("select[name='Filters.ViewMode']");
            var fromDate = fromDateInput ? fromDateInput.value : '';
            var toDate = toDateInput ? toDateInput.value : '';
            var viewMode = viewModeInput ? viewModeInput.value : '0';
            return { productId: productId, fromDate: fromDate, toDate: toDate, viewMode: viewMode };
        }

        function changePageSize(select) {
            var p = getProfitLossParams();
            var url = `/Report/ProfitLossReport?pageNumber=1&Filters.ProductId=${encodeURIComponent(p.productId)}&pageSize=${select.value}&Filters.FromDate=${encodeURIComponent(p.fromDate)}&Filters.ToDate=${encodeURIComponent(p.toDate)}&Filters.ViewMode=${encodeURIComponent(p.viewMode)}`;
            window.location.href = url;
        }
    </script>
    <script>
        document.getElementById("exportExcelBtn").addEventListener("click", function (e) {
            e.preventDefault();
            var p = getProfitLossParams();
            var url = `/Report/ExportProfitLossExcel?productId=${p.productId}&FromDate=${p.fromDate}&ToDate=${p.toDate}&viewMode=${encodeURIComponent(p.viewMode)}`;
            exportWithLoader(url, 'ProfitLossReport_export.xlsx', 'Preparing Excel export... Please wait.');
        });

        document.getElementById("exportPdfBtn").addEventListener("click", function (e) {
            e.preventDefault();
            var p = getProfitLossParams();
            var url = `/Report/ExportProfitLossPdf?productId=${p.productId}&FromDate=${p.fromDate}&ToDate=${p.toDate}&viewMode=${encodeURIComponent(p.viewMode)}`;
            exportWithLoader(url, 'ProfitLossReport_export.pdf', 'Preparing PDF export... Please wait.');
        });
    </script>
}




