@model IMS.Models.AnalyticsDashboardPageModel
@using System.Globalization
@{
    ViewData["Title"] = "Analytics";
    var pkr = new CultureInfo("ur-PK");
    string Money(decimal v) => v.ToString("C", pkr);
}
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,600;0,9..40,700;1,9..40,400&family=Syne:wght@600;700&display=swap" rel="stylesheet" />
<style>
    :root {
        --bg-deep: #060a0f;
        --surface: rgba(26, 35, 50, 0.72);
        --surface2: #243044;
        --text: #e8eef5;
        --muted: #8b9cb3;
        --accent: #22d3ee;
        --accent2: #a78bfa;
        --success: #34d399;
        --warning: #fbbf24;
        --danger: #f87171;
        --border: rgba(255,255,255,.1);
        --radius: 14px;
        --font: "DM Sans", system-ui, sans-serif;
        --font-display: "Syne", var(--font);
    }
    .analytics-shell {
        position: relative;
        min-height: 100vh;
        overflow-x: hidden;
        background: var(--bg-deep);
    }
    .analytics-aurora {
        position: fixed;
        inset: -35%;
        background: conic-gradient(from 210deg at 50% 45%,
            rgba(34, 211, 238, 0.22) 0deg,
            transparent 55deg,
            rgba(167, 139, 250, 0.18) 110deg,
            transparent 170deg,
            rgba(52, 211, 153, 0.14) 240deg,
            transparent 300deg,
            rgba(34, 211, 238, 0.12) 360deg);
        animation: analytics-aurora-spin 32s linear infinite;
        filter: blur(90px);
        opacity: 0.95;
        pointer-events: none;
        z-index: 0;
    }
    @@keyframes analytics-aurora-spin {
        to { transform: rotate(360deg); }
    }
    .analytics-beam {
        position: fixed;
        pointer-events: none;
        z-index: 0;
        background: linear-gradient(102deg, transparent 35%, rgba(186, 230, 253, 0.12) 48%, rgba(255, 255, 255, 0.18) 50%, rgba(186, 230, 253, 0.1) 52%, transparent 65%);
        filter: blur(1px);
        opacity: 0.45;
        animation: analytics-beam-sweep 14s ease-in-out infinite;
    }
    .analytics-beam-a {
        width: 55%;
        height: 140%;
        top: -20%;
        left: 5%;
        transform: rotate(15deg);
    }
    .analytics-beam-b {
        width: 45%;
        height: 120%;
        top: 10%;
        right: -5%;
        transform: rotate(-18deg);
        opacity: 0.28;
        animation: none;
        background: linear-gradient(105deg, transparent 40%, rgba(167, 139, 250, 0.18) 50%, transparent 60%);
    }
    @@keyframes analytics-beam-sweep {
        0%, 100% { opacity: 0.25; transform: translateX(-8%) rotate(15deg); }
        50% { opacity: 0.75; transform: translateX(12%) rotate(15deg); }
    }
    .analytics-grid-light {
        position: fixed;
        inset: 0;
        background-image:
            linear-gradient(rgba(255, 255, 255, 0.04) 1px, transparent 1px),
            linear-gradient(90deg, rgba(255, 255, 255, 0.04) 1px, transparent 1px);
        background-size: 56px 56px;
        mask-image: radial-gradient(ellipse 90% 70% at 50% 20%, black 0%, transparent 72%);
        pointer-events: none;
        z-index: 0;
        opacity: 0.6;
    }
    .analytics-noise {
        position: fixed;
        inset: 0;
        opacity: 0.035;
        pointer-events: none;
        z-index: 0;
        background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
    }
    .analytics-page {
        position: relative;
        z-index: 1;
        font-family: var(--font);
        color: var(--text);
        min-height: 100vh;
        padding: 1.5rem 1.25rem 3rem;
    }
    .analytics-page h1 {
        font-family: var(--font-display);
        font-weight: 700;
        letter-spacing: -0.02em;
        font-size: 1.75rem;
        margin: 0 0 .25rem;
    }
    .analytics-sub {
        color: var(--muted);
        font-size: .95rem;
        margin-bottom: 1.25rem;
    }
    .analytics-sub strong { color: var(--accent); }
    .filter-bar {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: .5rem;
        margin-bottom: 1.5rem;
        padding: .75rem 1rem;
        background: var(--surface);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        box-shadow: 0 4px 24px rgba(0, 0, 0, 0.35), inset 0 1px 0 rgba(255, 255, 255, 0.06);
    }
    .filter-bar button {
        font-family: var(--font);
        border: 1px solid var(--border);
        background: var(--surface2);
        color: var(--text);
        padding: .45rem .85rem;
        border-radius: 10px;
        font-size: .85rem;
        cursor: pointer;
        transition: background .15s, border-color .15s;
    }
    .filter-bar button:hover { background: #2d3d55; }
    .filter-bar button.active {
        border-color: var(--accent);
        background: rgba(34,211,238,.12);
        color: #fff;
    }
    #custom-range-panel {
        display: none;
        align-items: center;
        gap: .5rem;
        flex-wrap: wrap;
        margin-left: auto;
    }
    #custom-range-panel input[type="date"] {
        background: var(--surface2);
        border: 1px solid var(--border);
        color: var(--text);
        padding: .4rem .5rem;
        border-radius: 8px;
        font-family: var(--font);
    }
    #apply-custom-range {
        background: linear-gradient(135deg, var(--accent), #0891b2) !important;
        border: none !important;
        font-weight: 600;
    }
    #analytics-loading {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(15,20,25,.45);
        z-index: 50;
        align-items: center;
        justify-content: center;
        font-size: 1rem;
        color: var(--text);
    }
    .kpi-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
        gap: 1rem;
        margin-bottom: 1.5rem;
    }
    .kpi-card {
        background: var(--surface);
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        padding: 1.1rem 1.15rem;
        position: relative;
        overflow: hidden;
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.25), inset 0 1px 0 rgba(255, 255, 255, 0.05);
    }
    .kpi-card::before {
        content: "";
        position: absolute;
        top: 0; left: 0; right: 0;
        height: 3px;
        background: linear-gradient(90deg, var(--accent), var(--accent2));
        opacity: .85;
    }
    .kpi-card.sales::before { background: linear-gradient(90deg, #22d3ee, #06b6d4); }
    .kpi-card.purchase::before { background: linear-gradient(90deg, #a78bfa, #7c3aed); }
    .kpi-card.expense::before { background: linear-gradient(90deg, #fb7185, #f43f5e); }
    .kpi-card.people::before { background: linear-gradient(90deg, #34d399, #059669); }
    .kpi-card.stock::before { background: linear-gradient(90deg, #fbbf24, #d97706); }
    .kpi-label {
        font-size: .72rem;
        text-transform: uppercase;
        letter-spacing: .08em;
        color: var(--muted);
        margin-bottom: .35rem;
    }
    .kpi-value {
        font-family: var(--font-display);
        font-size: 1.45rem;
        font-weight: 700;
        line-height: 1.2;
    }
    .kpi-meta { font-size: .8rem; color: var(--muted); margin-top: .35rem; }
    .charts-row {
        display: grid;
        grid-template-columns: 1fr;
        gap: 1rem;
        margin-bottom: 1.5rem;
    }
    @@media (min-width: 1100px) {
        .charts-row { grid-template-columns: 1.25fr 0.95fr; align-items: stretch; }
    }
    .chart-row {
        background: var(--surface);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        padding: 1.25rem;
        box-shadow: 0 12px 40px rgba(0, 0, 0, 0.35), inset 0 1px 0 rgba(255, 255, 255, 0.06);
    }
    .stock-panel .stock-select-wrap {
        margin-bottom: 1rem;
    }
    .stock-panel label {
        display: block;
        font-size: .75rem;
        text-transform: uppercase;
        letter-spacing: .08em;
        color: var(--muted);
        margin-bottom: .4rem;
    }
    .stock-panel select {
        width: 100%;
        max-width: 100%;
        padding: .55rem .75rem;
        border-radius: 10px;
        border: 1px solid var(--border);
        background: rgba(15, 20, 30, 0.85);
        color: var(--text);
        font-family: var(--font);
        font-size: .9rem;
    }
    .stock-panel select:focus {
        outline: none;
        border-color: var(--accent);
        box-shadow: 0 0 0 3px rgba(34, 211, 238, 0.2);
    }
    .stock-product-title {
        font-size: .85rem;
        color: var(--accent);
        margin-bottom: .75rem;
        min-height: 1.2em;
        font-weight: 600;
    }
    .stock-legend {
        display: flex;
        flex-wrap: wrap;
        gap: .75rem 1.25rem;
        margin-top: 1rem;
        font-size: .8rem;
        color: var(--muted);
    }
    .stock-legend span strong { color: var(--text); font-weight: 600; }
    .chart-wrap-stock { position: relative; height: 260px; }
    .chart-row h2 {
        font-family: var(--font-display);
        font-size: 1.1rem;
        margin: 0 0 1rem;
        color: var(--muted);
        font-weight: 600;
    }
    .chart-wrap { position: relative; height: 320px; }
    .section-title {
        font-family: var(--font-display);
        font-size: .95rem;
        color: var(--muted);
        text-transform: uppercase;
        letter-spacing: .12em;
        margin: 1.5rem 0 .75rem;
    }
    .footer-note {
        text-align: center;
        color: var(--muted);
        font-size: .8rem;
        margin-top: 2rem;
        opacity: .8;
    }
</style>

<div class="analytics-shell">
    <div class="analytics-aurora" aria-hidden="true"></div>
    <div class="analytics-beam analytics-beam-a" aria-hidden="true"></div>
    <div class="analytics-beam analytics-beam-b" aria-hidden="true"></div>
    <div class="analytics-grid-light" aria-hidden="true"></div>
    <div class="analytics-noise" aria-hidden="true"></div>

    <div class="analytics-page">
    <div id="analytics-loading"><span>Loading analytics…</span></div>

    <h1>Business analytics</h1>
    <p class="analytics-sub">
        @if (Model.IsAdmin)
        { <text>All branches · </text> }
        else if (!string.IsNullOrEmpty(Model.BranchName))
        { <text>Branch <strong>@Model.BranchName</strong> · </text> }
        <span id="range-label">@Model.FromDate.ToString("yyyy-MM-dd") → @Model.ToDate.ToString("yyyy-MM-dd")</span>
    </p>

    <div class="filter-bar">
        <button type="button" data-analytics-preset="today" class="active">Today</button>
        <button type="button" data-analytics-preset="yesterday">Yesterday</button>
        <button type="button" data-analytics-preset="last7">Last 7 days</button>
        <button type="button" data-analytics-preset="last30">Last 30 days</button>
        <button type="button" data-analytics-preset="thismonth">This month</button>
        <button type="button" data-analytics-preset="custom">Custom range</button>
        <div id="custom-range-panel">
            <input type="date" id="date-from" />
            <span style="color:var(--muted)">to</span>
            <input type="date" id="date-to" />
            <button type="button" id="apply-custom-range">Apply</button>
        </div>
    </div>

    <div class="section-title">Overview</div>
    <div class="kpi-grid">
        <div class="kpi-card sales">
            <div class="kpi-label">Sales (revenue)</div>
            <div class="kpi-value" id="kpi-sales">@Money(Model.Summary.SalesTotal)</div>
            <div class="kpi-meta"><span id="kpi-sales-count">@Model.Summary.SalesCount</span> transactions</div>
        </div>
        <div class="kpi-card purchase">
            <div class="kpi-label">Purchases</div>
            <div class="kpi-value" id="kpi-purchase">@Money(Model.Summary.PurchaseTotal)</div>
            <div class="kpi-meta"><span id="kpi-purchase-count">@Model.Summary.PurchaseCount</span> orders</div>
        </div>
        <div class="kpi-card expense">
            <div class="kpi-label">Expenses</div>
            <div class="kpi-value" id="kpi-expenses">@Money(Model.Summary.ExpensesTotal)</div>
            <div class="kpi-meta"><span id="kpi-expenses-count">@Model.Summary.ExpensesCount</span> entries</div>
        </div>
        <div class="kpi-card people">
            <div class="kpi-label">New customers</div>
            <div class="kpi-value" id="kpi-customers">@Model.Summary.NewCustomers</div>
            <div class="kpi-meta">Created in period</div>
        </div>
        <div class="kpi-card people">
            <div class="kpi-label">New products</div>
            <div class="kpi-value" id="kpi-products-new">@Model.Summary.NewProducts</div>
            <div class="kpi-meta">Added in period</div>
        </div>
        <div class="kpi-card people">
            <div class="kpi-label">New employees</div>
            <div class="kpi-value" id="kpi-employees">@Model.Summary.NewEmployees</div>
            <div class="kpi-meta">Hires in period</div>
        </div>
        <div class="kpi-card stock">
            <div class="kpi-label">Stock available (units)</div>
            <div class="kpi-value" id="kpi-stock">@Model.Summary.StockAvailableTotal.ToString("N2", pkr)</div>
            <div class="kpi-meta">Snapshot · enabled products</div>
        </div>
        <div class="kpi-card stock">
            <div class="kpi-label">Active products</div>
            <div class="kpi-value" id="kpi-active-products">@Model.Summary.ActiveProductsTotal</div>
            <div class="kpi-meta">Total catalog (scope)</div>
        </div>
        <div class="kpi-card sales">
            <div class="kpi-label">Net flow hint</div>
            <div class="kpi-value" id="kpi-netflow">@Money(Model.Summary.NetFlowHint)</div>
            <div class="kpi-meta">Sales − purchases − expenses</div>
        </div>
    </div>

    <div class="charts-row">
        <div class="chart-row">
            <h2>Sales trend</h2>
            <div class="chart-wrap">
                <canvas id="salesTrendChart"></canvas>
            </div>
        </div>
        <div class="chart-row stock-panel">
            <h2>Stock by product</h2>
            <div class="stock-select-wrap">
                <label for="stock-product-select">Product</label>
                <select id="stock-product-select">
                    @if (Model.StockProducts.Count == 0)
                    {
                        <option value="0">No products in scope</option>
                    }
                    else
                    {
                        foreach (var p in Model.StockProducts)
                        {
                            <option value="@p.Value">@p.Text</option>
                        }
                    }
                </select>
            </div>
            <div class="stock-product-title" id="stock-selected-name"></div>
            <div class="chart-wrap-stock">
                <canvas id="stockDonutChart"></canvas>
            </div>
            <div class="stock-legend">
                <span>In stock: <strong id="stock-lbl-in">—</strong></span>
                <span>Used: <strong id="stock-lbl-used">—</strong></span>
                <span>Available: <strong id="stock-lbl-avail">—</strong></span>
            </div>
        </div>
    </div>

    <p class="footer-note">Figures use Pakistan (PKT) calendar dates. Branch users see data tied to legacy <code>Users.BranchId</code> via <code>CreatedBy</code> where applicable.</p>
    </div>
</div>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<script src="~/js/dashboard-analytics.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', function () {
        const labels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.SalesTrend.Select(t => t.Label)));
        const data = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.SalesTrend.Select(t => t.Amount)));
        const canvas = document.getElementById('salesTrendChart');
        if (canvas && typeof Chart !== 'undefined') {
            const ctx = canvas.getContext('2d');
            window._salesTrendChartInstance = new Chart(ctx, {
                type: 'line',
                data: {
                    labels,
                    datasets: [{
                        label: 'Sales',
                        data,
                        fill: true,
                        borderColor: '#22d3ee',
                        backgroundColor: 'rgba(34, 211, 238, 0.12)',
                        tension: 0.35,
                        pointRadius: 3
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: {
                        y: { beginAtZero: true, ticks: { color: '#8b9cb3', callback: v => 'Rs.' + v.toLocaleString() } },
                        x: { ticks: { color: '#8b9cb3', maxRotation: 45, minRotation: 0 } }
                    }
                }
            });
        }
        window.initAnalyticsDashboard();
        const stockProducts = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.StockProducts.Select(p => new { value = p.Value, text = p.Text })));
        const firstStockId = @Html.Raw(Model.StockProducts.Count > 0 ? System.Text.Json.JsonSerializer.Serialize(Model.StockProducts[0].Value) : "null");
        window.initStockDonutChart(stockProducts, firstStockId);
    });
</script>
}
