@model IMS.Models.VendorViewModel;
@{
    bool isAdmin = Convert.ToBoolean(User.FindFirst("IsAdmin")?.Value);
    string role = isAdmin ? "Admin" : "User";
    ViewBag.Title = "Vendor List";
}

<link href="~/css/product-management.css" rel="stylesheet" />
<link href="~/css/user-management.css" rel="stylesheet" />
<style>
    @@font-face {
        font-family: 'Jameel Noori Nastaleeq';
        src: url('/fonts/download/Jameel Noori Nastaleeq.ttf') format('truetype');
        font-weight: normal;
        font-style: normal;
        font-size:x-large;
    }
    .urdu-cell {
        font-family: 'Jameel Noori Nastaleeq', 'Urdu Typesetting', 'Traditional Arabic', Tahoma, serif;
        direction: rtl;
        text-align: right;
        unicode-bidi: embed;
        font-size: x-large;
    }
</style>
<div class="card shadow-sm">
    <div class="card-header bg-primary text-white">
            <h2 class="mb-0" style="text-align:center"> Supplier/Vendor Management </h2>
    </div>
    <div class="card-body">
        <!-- Enhanced Search Section -->
        <div class="card mb-4 user-search-card">
            <div class="card-header user-search-header bg-transparent border-0 py-3">
                <div class="d-flex align-items-center justify-content-between">
                    <h5 class="mb-0 user-search-title">
                        <i class="fa-solid fa-search user-search-icon me-2"></i>Search & Actions
                    </h5>
                </div>
            </div>
            <div class="card-body user-search-section pt-0">
                <form asp-action="Index" 
                      asp-controller="Vendor" 
                      asp-route-searchUsername="@ViewData["searchUsername"]" 
                      asp-route-searchContactNo="@ViewData["searchContactNo"]"
                      asp-route-searchEmail="@ViewData["searchEmail"]" 
                      method="get">
                    
                    <div class="row g-3 mb-4">
                        <!-- Search Inputs Row -->
                        <div class="col-md-4">
                            <div class="form-floating user-search-floating">
                                <input type="text"
                                       name="searchUsername"
                                       value="@Context.Request.Query["searchUsername"]"
                                       class="form-control user-search-input"
                                       placeholder="Enter Vendor Name"
                                       onchange="SearchNameChange()" />
                                <label class="text-muted">
                                    <i class="fa-solid fa-building me-1"></i>Vendor Name
                                </label>
                            </div>
                        </div>
                        
                        <div class="col-md-4">
                            <div class="form-floating user-search-floating">
                                <input type="text"
                                       name="searchContactNo"
                                       value="@Context.Request.Query["searchContactNo"]"
                                       class="form-control user-search-input"
                                       placeholder="Enter Contact Number"
                                       onchange="SearchNameChange()" />
                                <label class="text-muted">
                                    <i class="fa-solid fa-phone me-1"></i>Phone Number
                                </label>
                            </div>
                        </div>
                        
                       @*  <div class="col-md-4">
                            <div class="form-floating user-search-floating">
                                <input type="text"
                                       name="searchEmail"
                                       value="@Context.Request.Query["searchEmail"]"
                                       class="form-control user-search-input"
                                       placeholder="Enter NTN"
                                       onchange="SearchNameChange()" />
                                <label class="text-muted">
                                    <i class="fa-solid fa-id-card me-1"></i>NTN Number
                                </label>
                            </div>
                        </div> *@
                    </div>
                    
                    <!-- Action Buttons Row -->
                    <div class="row">
                        <div class="col-12">
                            <div class="d-flex justify-content-between align-items-center">
                                <div class="d-flex gap-2">
                                    <button type="submit" class="btn btn-user-search">
                                        <i class="fa-solid fa-magnifying-glass me-2"></i>Search Vendors
                                    </button>
                                    <a asp-action="Index" class="btn btn-user-reset">
                                        <i class="fa-solid fa-refresh me-2"></i>Reset Filters
                                    </a>
                                    <a href="#" id="exportExcelBtn" class="btn btn-warning btn-sm">
                                        <i class="fa fa-file-excel text-success me-1"></i> Export Excel
                                    </a>
                                    <a href="#" id="exportPdfBtn" class="btn btn-warning btn-sm">
                                        <i class="fa fa-file-pdf text-danger me-1"></i> Export PDF
                                    </a>
                                    <a asp-action="CreatePayment" asp-controller="VendorPayments" class="btn btn-user-reset">
                                        <i class="fa-solid fa-scale-balanced me-1"></i>Advance Payment
                                    </a>
                                    <button type="button" class="btn btn-info btn-sm" onclick="showVendorOpenBalanceModal()">
                                        <i class="fa-solid fa-scale-balanced me-1"></i> Vendor Payable
                                    </button>
                                </div>
                                <a asp-action="Create" class="btn btn-user-create">
                                    <i class="fa-solid fa-plus me-2"></i>Create Vendor
                                </a>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
        <div class="table-responsive">
            <table class="table table-striped table-bordered custom-table">
                <thead>
                    <tr>
                        <th> Vendor Id </th>
                        <th>Vendor Name</th>
                        <th>Urdu Name</th>
                        <th>Contact Number</th>
                        <th>Email</th>
                        <th>Address</th>
                        <th>Is Deleted</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.VendorList.Any())
                    {
                            @foreach (var item in Model.VendorList)
                        {
                            <tr>
                                <td>@Html.DisplayFor(modelItem => item.SupplierId)</td>
                                <td>@Html.DisplayFor(modelitem => item.SupplierName)</td>
                                <td class="urdu-cell" lang="ur">@(item.VendorUrduName ?? "—")</td>
                                <td>@Html.DisplayFor(modelitem => item.SupplierPhoneNumber)</td>
                                <td>@Html.DisplayFor(modelitem => item.SupplierEmail)</td>
                                <td>@Html.DisplayFor(modelitem => item.SupplierAddress)</td>
                                    <td>
                                        <div class="form-check form-switch">
                                            <input class="form-check-input @(item.IsDeleted ? "bg-success" : "bg-danger")"
                                                   type="checkbox"
                                                   @(item.IsDeleted ? "checked" : "")
                                                   disabled>
                                        </div>
                                    </td>
                               

                                <td class="table-actions">
                                    <div class="btn-group" role="group">
                                        <a asp-action="Details" asp-route-id="@item.SupplierId" class="btn btn-sm btn-outline-info" title="View Details">
                                            <i class="fa-solid fa-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@item.SupplierId" class="btn btn-sm btn-outline-warning" title="Edit Vendor">
                                            <i class="fa-solid fa-edit"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.SupplierId" class="btn btn-sm btn-outline-danger" title="Delete Vendor">
                                            <i class="fa-solid fa-trash"></i>
                                        </a>
                                    </div>
                                </td>


                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center">No Record found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="d-flex justify-content-between align-items-center mt-3">
            <span class="text-muted">Total: @Model.TotalCount | Showing @Model.PageSize Records per page</span>
            <div class="end-0">
                <label for="pageSize" class="form-label me-2 text-muted">Items Per Page :</label>
                <select id="pageSize" class="form-select form-select-sm d-inline-block w-auto" onchange="changePageSize(this)">
                    <option value="5" selected="@(Model.PageSize == 5)">5</option>
                    <option value="10" selected="@(Model.PageSize == 10)">10</option>
                    <option value="25" selected="@(Model.PageSize == 25)">25</option>
                </select>
            </div>
            @if (Model.TotalPages > 1)
            {
                <nav aria-label="User pagination">
                    <ul class="pagination justify-content-center">
                        <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                            <a class="page-link" asp-action="Index" asp-route-pageNumber="1"
                               asp-route-pageSize="@Model.PageSize" asp-route-searchUsername="@ViewData["searchUsername"]">First</a>
                        </li>
                        <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                            <a class="page-link" asp-action="Index" asp-route-pageNumber="@(Model.CurrentPage - 1)" asp-route-pageSize="@Model.PageSize"
                               asp-route-searchUsername="@ViewData["searchUsername"]">Previous</a>
                        </li>
                        @{
                            int startPage = Math.Max(1, Model.CurrentPage - 1);
                            int endPage = Math.Min(Model.TotalPages, startPage + 2);
                            if (endPage - startPage < 2)
                            {
                                startPage = Math.Max(1, endPage - 2);
                            }

                        }
                        @for (int i = startPage; i <= endPage; i++)
                        {
                            <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                <a class="page-link" asp-action="Index" asp-route-pageNumber="@i" asp-route-pageSize="@Model.PageSize" asp-route-searchUsername="@ViewData["searchUsername"]">@i</a>
                            </li>
                        }
                        <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                            <a class="page-link" asp-action="Index" asp-route-pageNumber="@(Model.CurrentPage + 1)" asp-route-pageSize="@Model.PageSize" asp-route-searchUsername="@ViewData["searchUsername"]">Next</a>
                        </li>
                        <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                            <a class="page-link" asp-action="Index" asp-route-pageNumber="@Model.TotalPages" asp-route-pageSize="@Model.PageSize" asp-route-searchUsername="@ViewData["searchUsername"]">Last</a>
                        </li>
                    </ul>
                </nav>
            }
        </div>
    </div>
</div>

<!-- Vendor Open Balance Modal -->
<div class="modal fade" id="vendorOpenBalanceModal" tabindex="-1" aria-labelledby="vendorOpenBalanceModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-info text-white">
                <h5 class="modal-title" id="vendorOpenBalanceModalLabel">
                    <i class="fa-solid fa-scale-balanced me-2"></i>Vendor Open Balance
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="vendorOpenBalanceForm">
                    <div class="row g-3">
                        <div class="col-md-12">
                            <label for="openBalanceVendorSelect" class="form-label fw-semibold">
                                <i class="fa-solid fa-building me-1 text-primary"></i>Select Vendor <span class="text-danger">*</span>
                            </label>
                            <input id="openBalanceVendorSelect" style="width: 100%;" />
                            <input type="hidden" id="openBalanceVendorIdHidden" />
                            <span class="text-danger small" id="openBalanceVendorError"></span>
                        </div>
                        <div class="col-md-6">
                            <label for="openBalanceVendorCurrentBalance" class="form-label fw-semibold">
                                <i class="fa fa-wallet me-1 text-success"></i>Current Balance
                            </label>
                            <input type="text" id="openBalanceVendorCurrentBalance" class="form-control" readonly />
                            <small class="text-muted">Balance for the selected vendor</small>
                        </div>
                        <div class="col-md-6">
                            <label for="openBalanceVendorDate" class="form-label fw-semibold">
                                <i class="fa fa-calendar me-1 text-primary"></i>Date <span class="text-danger">*</span>
                            </label>
                            <input type="date" id="openBalanceVendorDate" class="form-control" required />
                            <span class="text-danger small" id="openBalanceVendorDateError"></span>
                        </div>
                       @*  <div class="col-md-6">
                            <label for="openBalanceVendorTypeSelect" class="form-label fw-semibold">
                                <i class="fa-solid fa-list me-1 text-primary"></i>Type <span class="text-danger">*</span>
                            </label>
                            <select id="openBalanceVendorTypeSelect" class="form-select">
                                <option value="">--Select Type--</option>
                                <option value="Payable">Payable</option>
                                <option value="Receivable">Receivable</option>
                            </select>
                            <span class="text-danger small" id="openBalanceVendorTypeError"></span>
                        </div> *@
                        <div class="col-md-12">
                            <label for="openBalanceVendorAmount" class="form-label fw-semibold">
                                <i class="fa fa-money-bill me-1 text-info"></i>Opening Balance <span class="text-danger">*</span>
                            </label>
                            <input type="number" id="openBalanceVendorAmount" class="form-control" step="0.001" min="0" placeholder="Enter opening balance" />
                            <span class="text-danger small" id="openBalanceVendorAmountError"></span>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-info" id="saveVendorOpenBalanceBtn" onclick="saveVendorOpenBalance(event)">
                    <i class="fa-solid fa-check me-1"></i>Save
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Enhanced Vendor Management JavaScript
        
        // Initialize page
        document.addEventListener('DOMContentLoaded', function() {
            initializeVendorManagement();
            if (typeof $ !== 'undefined' && typeof $.fn.kendoComboBox !== 'undefined') {
                initializeVendorOpenBalanceModal();
            } else {
                setTimeout(function() {
                    if (typeof $ !== 'undefined' && typeof $.fn.kendoComboBox !== 'undefined') {
                        initializeVendorOpenBalanceModal();
                    }
                }, 500);
            }
        });

        function formatCurrency(amount) {
            return 'Rs ' + parseFloat(amount).toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g, ",");
        }

        function initializeVendorOpenBalanceModal() {
            if ($("#openBalanceVendorSelect").length === 0) return;
            var existingCombo = $("#openBalanceVendorSelect").data("kendoComboBox");
            if (existingCombo) existingCombo.destroy();

            $("#openBalanceVendorSelect").kendoComboBox({
                placeholder: "--Select Vendor--",
                filter: "contains",
                suggest: true,
                minLength: 1,
                dataTextField: "text",
                dataValueField: "value",
                dataSource: {
                    transport: {
                        read: {
                            url: "@Url.Action("GetVendors", "Vendor")",
                            dataType: "json"
                        }
                    }
                },
                change: function() {
                    var vendorId = this.value();
                    $("#openBalanceVendorIdHidden").val(vendorId);
                    if (vendorId) {
                        loadVendorBalance(vendorId);
                    } else {
                        var balanceInput = document.getElementById('openBalanceVendorCurrentBalance');
                        balanceInput.value = '';
                        balanceInput.style.backgroundColor = '';
                        balanceInput.style.color = '';
                    }
                }
            });
        }

        function loadVendorBalance(vendorId) {
            var balanceInput = document.getElementById('openBalanceVendorCurrentBalance');
            balanceInput.value = 'Loading...';
            balanceInput.style.backgroundColor = '#f8f9fa';
            balanceInput.style.color = '#6c757d';

            fetch('@Url.Action("GetPreviousDueAmount", "VendorBills")?vendorId=' + vendorId)
                .then(function(r) { return r.json(); })
                .then(function(data) {
                    if (data.success && data.previousDueAmount !== undefined) {
                        var amount = parseFloat(data.previousDueAmount);
                        balanceInput.value = formatCurrency(amount);
                        balanceInput.style.backgroundColor = amount > 0 ? '#fff3cd' : '#d1edff';
                        balanceInput.style.color = amount > 0 ? '#856404' : '#0c5460';
                    } else {
                        balanceInput.value = formatCurrency(0);
                        balanceInput.style.backgroundColor = '';
                        balanceInput.style.color = '';
                    }
                })
                .catch(function() {
                    balanceInput.value = formatCurrency(0);
                    balanceInput.style.backgroundColor = '#f8d7da';
                    balanceInput.style.color = '#721c24';
                });
        }

        function showVendorOpenBalanceModal() {
            var combo = $("#openBalanceVendorSelect").data("kendoComboBox");
            if (combo) {
                combo.value("");
            }
            $("#openBalanceVendorIdHidden").val("");
            $("#openBalanceVendorCurrentBalance").val('');
            $("#openBalanceVendorAmount").val('');
            var now = new Date();
            var year = now.getFullYear();
            var month = String(now.getMonth() + 1).padStart(2, '0');
            var day = String(now.getDate()).padStart(2, '0');
            $("#openBalanceVendorDate").val(year + '-' + month + '-' + day);
            $("#openBalanceVendorError").text('');
            $("#openBalanceVendorTypeError").text('');
            $("#openBalanceVendorAmountError").text('');
            $("#openBalanceVendorDateError").text('');

            var modal = new bootstrap.Modal(document.getElementById('vendorOpenBalanceModal'));
            modal.show();
        }

        function saveVendorOpenBalance(event) {
            var vendorId = $("#openBalanceVendorIdHidden").val();
            var amount = parseFloat($("#openBalanceVendorAmount").val()) || 0;
            var balanceDate = $("#openBalanceVendorDate").val();

            $("#openBalanceVendorError").text('');
            $("#openBalanceVendorTypeError").text('');
            $("#openBalanceVendorAmountError").text('');
            $("#openBalanceVendorDateError").text('');

            var isValid = true;
            if (!vendorId) {
                $("#openBalanceVendorError").text('Please select a vendor');
                isValid = false;
            }
            if (amount <= 0) {
                $("#openBalanceVendorAmountError").text('Please enter a valid opening balance');
                isValid = false;
            }
            if (!balanceDate) {
                $("#openBalanceVendorDateError").text('Please select a date');
                isValid = false;
            }
            if (!isValid) return;

            var submitBtn = (event && event.target) ? event.target : document.getElementById('saveVendorOpenBalanceBtn');
            if (submitBtn) {
                submitBtn.disabled = true;
                submitBtn.innerHTML = '<i class="fa-solid fa-spinner fa-spin me-1"></i>Saving...';
            }
            fetch('@Url.Action("SaveVendorOpenBalance", "VendorBills")', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ vendorId: parseInt(vendorId, 10), openingBalance: amount, balanceDate: balanceDate })
            })
            .then(function(r) { return r.json(); })
            .then(function(data) {
                bootstrap.Modal.getInstance(document.getElementById('vendorOpenBalanceModal')).hide();
                if (data.success) {
                    if (typeof toastr !== 'undefined') toastr.success(data.message || 'Opening balance saved.');
                    else alert(data.message || 'Opening balance saved.');
                } else {
                    if (typeof toastr !== 'undefined') toastr.error(data.message || 'Failed to save.');
                    else alert(data.message || 'Failed to save.');
                }
            })
            .catch(function(err) {
                console.error('Save vendor opening balance error:', err);
                if (typeof toastr !== 'undefined') toastr.error('Error saving opening balance.');
                else alert('Error saving opening balance.');
            })
            .finally(function() {
                if (submitBtn) {
                    submitBtn.disabled = false;
                    submitBtn.innerHTML = '<i class="fa-solid fa-check me-1"></i>Save';
                }
            });
        }

        function initializeVendorManagement() {
            // Add loading states to buttons
            addLoadingStates();
            
            // Add smooth animations
            addSmoothAnimations();
            
            // Add form validation feedback
            addFormValidation();
        }

        function addLoadingStates() {
            const searchBtn = document.querySelector('.btn-user-search');
            const resetBtn = document.querySelector('.btn-user-reset');
            
            if (searchBtn) {
                searchBtn.addEventListener('click', function() {
                    this.classList.add('btn-loading');
                    this.innerHTML = '<i class="fa-solid fa-spinner fa-spin me-2"></i>Searching...';
                });
            }
            
            if (resetBtn) {
                resetBtn.addEventListener('click', function() {
                    this.classList.add('btn-loading');
                    this.innerHTML = '<i class="fa-solid fa-spinner fa-spin me-2"></i>Refreshing...';
                });
            }
        }

        function addSmoothAnimations() {
            // Add hover effects to form elements
            const formElements = document.querySelectorAll('.form-floating');
            formElements.forEach(element => {
                element.addEventListener('mouseenter', function() {
                    this.style.transform = 'translateY(-2px)';
                    this.style.transition = 'transform 0.3s ease';
                });
                
                element.addEventListener('mouseleave', function() {
                    this.style.transform = 'translateY(0)';
                });
            });
        }

        function addFormValidation() {
            const inputs = document.querySelectorAll('.form-control, .form-select');
            inputs.forEach(input => {
                input.addEventListener('blur', function() {
                    if (this.value.trim() !== '') {
                        this.classList.add('is-valid');
                        this.classList.remove('is-invalid');
                    } else {
                        this.classList.remove('is-valid');
                    }
                });
                
                input.addEventListener('input', function() {
                    if (this.classList.contains('is-invalid')) {
                        this.classList.remove('is-invalid');
                    }
                });
            });
        }

        function SearchNameChange() {
            // Add loading state
            const searchBtn = document.querySelector('.btn-user-search');
            if (searchBtn) {
                searchBtn.classList.add('btn-loading');
            }
            
            // Get form values
            const form = document.querySelector('form');
            const formData = new FormData(form);
            const params = new URLSearchParams();
            
            // Add all form data to params
            for (let [key, value] of formData.entries()) {
                if (value.trim() !== '') {
                    params.append(key, value);
                }
            }
            
            // Add pagination
            params.set('pageNumber', '1');
            params.set('pageSize', document.getElementById('pageSize')?.value || '10');
            
            // Redirect with parameters
            window.location.href = '@Url.Action("Index", "Vendor")' + '?' + params.toString();
        }

        function changePageSize(select) {
            // Add loading state
            const searchBtn = document.querySelector('.btn-user-search');
            if (searchBtn) {
                searchBtn.classList.add('btn-loading');
            }
            
            // Get current form values
            const form = document.querySelector('form');
            const formData = new FormData(form);
            const params = new URLSearchParams();
            
            // Add all form data to params
            for (let [key, value] of formData.entries()) {
                if (value.trim() !== '') {
                    params.append(key, value);
                }
            }
            
            // Add pagination
            params.set('pageNumber', '1');
            params.set('pageSize', select.value);
            
            // Redirect with parameters
            window.location.href = '@Url.Action("Index", "Vendor")' + '?' + params.toString();
        }

        // Add keyboard shortcuts
        document.addEventListener('keydown', function(e) {
            // Ctrl + Enter to search
            if (e.ctrlKey && e.key === 'Enter') {
                e.preventDefault();
                const searchBtn = document.querySelector('.btn-user-search');
                if (searchBtn) {
                    searchBtn.click();
                }
            }
            
            // Escape to reset
            if (e.key === 'Escape') {
                const resetBtn = document.querySelector('.btn-user-reset');
                if (resetBtn) {
                    resetBtn.click();
                }
            }
        });

        // Add tooltips
        document.addEventListener('DOMContentLoaded', function() {
            const tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
            tooltipTriggerList.map(function (tooltipTriggerEl) {
                return new bootstrap.Tooltip(tooltipTriggerEl);
            });
        });

        function getVendorExportParams() {
            return {
                name: document.querySelector('input[name="searchUsername"]')?.value || '',
                phoneNumber: document.querySelector('input[name="searchContactNo"]')?.value || '',
                ntn: document.querySelector('input[name="searchEmail"]')?.value || ''
            };
        }
        document.getElementById("exportExcelBtn").addEventListener("click", function (e) {
            e.preventDefault();
            var p = getVendorExportParams();
            var params = new URLSearchParams();
            if (p.name) params.set('name', p.name); if (p.phoneNumber) params.set('phoneNumber', p.phoneNumber); if (p.ntn) params.set('ntn', p.ntn);
            var url = '@Url.Action("ExportExcel", "Vendor")' + (params.toString() ? '?' + params.toString() : '');
            exportWithLoader(url, 'Vendors_export.xlsx', 'Preparing Excel export... Please wait.');
        });
        document.getElementById("exportPdfBtn").addEventListener("click", function (e) {
            e.preventDefault();
            var p = getVendorExportParams();
            var params = new URLSearchParams();
            if (p.name) params.set('name', p.name); if (p.phoneNumber) params.set('phoneNumber', p.phoneNumber); if (p.ntn) params.set('ntn', p.ntn);
            var url = '@Url.Action("ExportPdf", "Vendor")' + (params.toString() ? '?' + params.toString() : '');
            exportWithLoader(url, 'Vendors_export.pdf', 'Preparing PDF export... Please wait.');
        });
    </script>
}
