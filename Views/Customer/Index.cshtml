@model IMS.Models.CustomerViewModel;
@{
    bool isAdmin = Convert.ToBoolean(User.FindFirst("IsAdmin")?.Value);
    string role = isAdmin ? "Admin" : "User";
    ViewBag.Title = "Customers List";
}

<link href="~/css/product-management.css" rel="stylesheet" />
<link href="~/css/user-management.css" rel="stylesheet" />
<style>
    @@font-face {
        font-family: 'Jameel Noori Nastaleeq';
        src: url('/fonts/download/Jameel Noori Nastaleeq.ttf') format('truetype');
        font-weight: normal;
        font-style: normal;
    }
    .urdu-cell {
        font-family: 'Jameel Noori Nastaleeq', 'Urdu Typesetting', 'Traditional Arabic', Tahoma, serif;
        direction: rtl;
        text-align: right;
        unicode-bidi: embed;
    }
</style>

<div class="card shadow-sm">
    <div class="card-header bg-primary text-white">
        <h2 class="mb-0" style="text-align:center"> Customer Management</h2>
    </div>
    <div class="card-body">
        <!-- Enhanced Search Section -->
        <div class="card mb-4 user-search-card">
            <div class="card-header user-search-header bg-transparent border-0 py-3">
                <div class="d-flex align-items-center justify-content-between">
                    <h5 class="mb-0 user-search-title">
                        <i class="fa-solid fa-search user-search-icon me-2"></i>Search & Actions
                    </h5>
                </div>
            </div>
            <div class="card-body user-search-section pt-0">
                <form asp-action="Index" 
                      asp-controller="Customer" 
                      method="get">
                    
                    <div class="row g-3 mb-4">
                        <!-- Search Inputs Row -->
                        <div class="col-md-4">
                            <div class="form-floating user-search-floating">
                                <input type="text"
                                       asp-for="Filters.CustomerName"
                                       class="form-control user-search-input"
                                       placeholder="Enter Customer Name"
                                       onchange="SearchNameChange()" />
                                <label class="text-muted">
                                    <i class="fa-solid fa-user me-1"></i>Customer Name
                                </label>
                            </div>
                        </div>
                        
                        <div class="col-md-4">
                            <div class="form-floating user-search-floating">
                                <input type="text"
                                       asp-for="Filters.PhoneNumber"
                                       class="form-control user-search-input"
                                       placeholder="Enter Contact Number"
                                       onchange="SearchNameChange()" />
                                <label class="text-muted">
                                    <i class="fa-solid fa-phone me-1"></i>Phone Number
                                </label>
                            </div>
                        </div>
                        
                        <div class="col-md-4">
                            <div class="form-floating user-search-floating">
                                <input type="text"
                                       asp-for="Filters.Email"
                                       class="form-control user-search-input"
                                       placeholder="Enter Email"
                                       onchange="SearchNameChange()" />
                                <label class="text-muted">
                                    <i class="fa-solid fa-envelope me-1"></i>Email Address
                                </label>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Action Buttons Row -->
                    <div class="row">
                        <div class="col-12">
                            <div class="d-flex justify-content-between align-items-center">
                                <div class="d-flex gap-2">
                                    <button type="submit" class="btn btn-user-search">
                                        <i class="fa-solid fa-magnifying-glass me-2"></i>Search Customers
                                    </button>
                                    <a asp-action="Index" class="btn btn-user-reset">
                                        <i class="fa-solid fa-refresh me-2"></i>Reset Filters
                                    </a>
                                    <a href="#" id="exportExcelBtn" class="btn btn-warning btn-sm">
                                        <i class="fa fa-file-excel text-success me-1"></i> Export Excel
                                    </a>
                                    <a href="#" id="exportPdfBtn" class="btn btn-warning btn-sm">
                                        <i class="fa fa-file-pdf text-danger me-1"></i> Export PDF
                                    </a>
                                    <a asp-action="Create" asp-controller="CustomerPayment" class="btn btn-user-reset">
                                        <i class="fa-solid fa-scale-balanced me-1"></i>Advance Payment
                                    </a>
                                    <button type="button" class="btn btn-info btn-sm" onclick="showCustomerOpenBalanceModal()">
                                        <i class="fa-solid fa-scale-balanced me-1"></i> Customer Payable
                                    </button>
                                </div>
                                <a asp-action="Create" class="btn btn-user-create">
                                    <i class="fa-solid fa-plus me-2"></i>Create Customer
                                </a>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
        <div class="table-responsive">
            <table class="table table-striped table-bordered custom-table">
                <thead>
                    <tr>
                        <th> Customer Id </th>
                        <th>Customer Name</th>
                        <th>Urdu Name</th>
                        <th>Contact Number</th>
                        <th>Email</th>
                        <th>Address</th>
                        <th>Enabled</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Customers.Any())
                    {
                        @foreach (var item in Model.Customers)
                        {
                            <tr>
                                <td>@Html.DisplayFor(modelItem => item.CustomerId)</td>
                                <td>@Html.DisplayFor(modelitem => item.CustomerName)</td>
                                <td class="urdu-cell" lang="ur">@(item.CustomerUrduName ?? "—")</td>
                                <td>@Html.DisplayFor(modelitem => item.CustomerContactNumber)</td>
                                <td>@Html.DisplayFor(modelitem => item.CustomerEmail)</td>
                                <td>@Html.DisplayFor(modelitem => item.CustomerAddress)</td>
                                    <td>
                                        <div class="form-check form-switch">
                                            <input class="form-check-input @(item.IsEnabled ? "bg-success" : "bg-danger")"
                                                   type="checkbox"
                                                   @(item.IsEnabled ? "checked" : "")
                                                   disabled>
                                        </div>
                                    </td>
                               

                                <td class="table-actions">
                                    <div class="btn-group" role="group">
                                      @*   <a asp-action="Details" asp-route-id="@item.CustomerId" class="btn btn-sm btn-outline-info" title="View Details">
                                            <i class="fa-solid fa-eye"></i>
                                        </a> *@
                                        <a asp-action="Edit" asp-route-id="@item.CustomerId" class="btn btn-sm btn-outline-warning" title="Edit Customer">
                                            <i class="fa-solid fa-edit"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.CustomerId" class="btn btn-sm btn-outline-danger" title="Delete Customer">
                                            <i class="fa-solid fa-trash"></i>
                                        </a>
                                    </div>
                                </td>


                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center">No Record found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="d-flex justify-content-between align-items-center mt-3">
            <span class="text-muted">Total: @Model.TotalCount | Showing @Model.PageSize Records per page</span>
                <div class="end-0">
                    <label for="pageSize" class="form-label me-2 text-muted">Items Per Page :</label>
                    <select id="pageSize" class="form-select form-select-sm d-inline-block w-auto" onchange="changePageSize(this)">
                        <option value="5" selected="@(Model.PageSize == 5)">5</option>
                        <option value="10" selected="@(Model.PageSize == 10)">10</option>
                        <option value="25" selected="@(Model.PageSize == 25)">25</option>
                    </select>
                </div>
            @if (Model.TotalPages > 1)
            {
                <nav aria-label="User pagination">
                    <ul class="pagination justify-content-center">
                        <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                            <a class="page-link" asp-action="Index" asp-route-pageNumber="1"
                               asp-route-pageSize="@Model.PageSize" 
                               asp-route-Filters.CustomerName="@Model.Filters?.CustomerName"
                               asp-route-Filters.PhoneNumber="@Model.Filters?.PhoneNumber"
                               asp-route-Filters.Email="@Model.Filters?.Email">First</a>
                        </li>
                        <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                            <a class="page-link" asp-action="Index" asp-route-pageNumber="@(Model.CurrentPage - 1)" asp-route-pageSize="@Model.PageSize"
                               asp-route-Filters.CustomerName="@Model.Filters?.CustomerName"
                               asp-route-Filters.PhoneNumber="@Model.Filters?.PhoneNumber"
                               asp-route-Filters.Email="@Model.Filters?.Email">Previous</a>
                        </li>
                        @{
                            int startPage = Math.Max(1, Model.CurrentPage - 1);
                            int endPage = Math.Min(Model.TotalPages, startPage + 2);
                            if (endPage - startPage < 2)
                            {
                                startPage = Math.Max(1, endPage - 2);
                            }

                        }
                        @for (int i = startPage; i <= endPage; i++)
                        {
                            <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                <a class="page-link" asp-action="Index" asp-route-pageNumber="@i" asp-route-pageSize="@Model.PageSize" 
                                   asp-route-Filters.CustomerName="@Model.Filters?.CustomerName"
                                   asp-route-Filters.PhoneNumber="@Model.Filters?.PhoneNumber"
                                   asp-route-Filters.Email="@Model.Filters?.Email">@i</a>
                            </li>
                        }
                        <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                            <a class="page-link" asp-action="Index" asp-route-pageNumber="@(Model.CurrentPage + 1)" asp-route-pageSize="@Model.PageSize" 
                               asp-route-Filters.CustomerName="@Model.Filters?.CustomerName"
                               asp-route-Filters.PhoneNumber="@Model.Filters?.PhoneNumber"
                               asp-route-Filters.Email="@Model.Filters?.Email">Next</a>
                        </li>
                        <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                            <a class="page-link" asp-action="Index" asp-route-pageNumber="@Model.TotalPages" asp-route-pageSize="@Model.PageSize" 
                               asp-route-Filters.CustomerName="@Model.Filters?.CustomerName"
                               asp-route-Filters.PhoneNumber="@Model.Filters?.PhoneNumber"
                               asp-route-Filters.Email="@Model.Filters?.Email">Last</a>
                        </li>
                    </ul>
                </nav>
            }
        </div>
    </div>
</div>

<!-- Customer Open Balance Modal -->
<div class="modal fade" id="customerOpenBalanceModal" tabindex="-1" aria-labelledby="customerOpenBalanceModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-info text-white">
                <h5 class="modal-title" id="customerOpenBalanceModalLabel">
                    <i class="fa-solid fa-scale-balanced me-2"></i>Customer Open Balance
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="customerOpenBalanceForm">
                    <div class="row g-3">
                        <div class="col-md-12">
                            <label for="openBalanceCustomerSelect" class="form-label fw-semibold">
                                <i class="fa-solid fa-user me-1 text-primary"></i>Select Customer <span class="text-danger">*</span>
                            </label>
                            <input id="openBalanceCustomerSelect" style="width: 100%;" />
                            <input type="hidden" id="openBalanceCustomerIdHidden" />
                            <span class="text-danger small" id="openBalanceCustomerError"></span>
                        </div>
                        <div class="col-md-6">
                            <label for="openBalanceCurrentBalance" class="form-label fw-semibold">
                                <i class="fa fa-wallet me-1 text-success"></i>Current Balance
                            </label>
                            <input type="text" id="openBalanceCurrentBalance" class="form-control" readonly />
                            <small class="text-muted">Balance for the selected customer</small>
                        </div>
                        <div class="col-md-6">
                            <label for="openBalanceDate" class="form-label fw-semibold">
                                <i class="fa fa-calendar me-1 text-primary"></i>Date <span class="text-danger">*</span>
                            </label>
                            <input type="date" id="openBalanceDate" class="form-control" required />
                            <span class="text-danger small" id="openBalanceDateError"></span>
                        </div>
                       @*  <div class="col-md-6">
                            <label for="openBalanceTypeSelect" class="form-label fw-semibold">
                                <i class="fa-solid fa-list me-1 text-primary"></i>Type <span class="text-danger">*</span>
                            </label>
                            <select id="openBalanceTypeSelect" class="form-select">
                                <option value="">--Select Type--</option>
                                <option value="Payable">Payable</option>
                                <option value="Receivable">Receivable</option>
                            </select>
                            <span class="text-danger small" id="openBalanceTypeError"></span>
                        </div> *@
                        <div class="col-md-12">
                            <label for="openBalanceAmount" class="form-label fw-semibold">
                                <i class="fa fa-money-bill me-1 text-info"></i>Opening Balance <span class="text-danger">*</span>
                            </label>
                            <input type="number" id="openBalanceAmount" class="form-control" step="0.01" min="0" placeholder="Enter opening balance" />
                            <span class="text-danger small" id="openBalanceAmountError"></span>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-info" id="saveCustomerOpenBalanceBtn" onclick="saveCustomerOpenBalance(event)">
                    <i class="fa-solid fa-check me-1"></i>Save
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Enhanced Customer Management JavaScript
        
        // Initialize page
        document.addEventListener('DOMContentLoaded', function() {
            initializeCustomerManagement();
            if (typeof $ !== 'undefined' && typeof $.fn.kendoComboBox !== 'undefined') {
                initializeCustomerOpenBalanceModal();
            } else {
                setTimeout(function() {
                    if (typeof $ !== 'undefined' && typeof $.fn.kendoComboBox !== 'undefined') {
                        initializeCustomerOpenBalanceModal();
                    }
                }, 500);
            }
        });

        function formatCurrency(amount) {
            return 'Rs ' + parseFloat(amount).toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g, ",");
        }

        function initializeCustomerOpenBalanceModal() {
            if ($("#openBalanceCustomerSelect").length === 0) return;
            var existingCombo = $("#openBalanceCustomerSelect").data("kendoComboBox");
            if (existingCombo) existingCombo.destroy();

            $("#openBalanceCustomerSelect").kendoComboBox({
                placeholder: "--Select Customer--",
                filter: "contains",
                suggest: true,
                minLength: 1,
                dataTextField: "text",
                dataValueField: "value",
                dataSource: {
                    transport: {
                        read: {
                            url: "@Url.Action("GetCustomersForDropdown", "Customer")",
                            dataType: "json"
                        }
                    }
                },
                change: function() {
                    var customerId = this.value();
                    $("#openBalanceCustomerIdHidden").val(customerId);
                    if (customerId) {
                        loadCustomerBalance(customerId);
                    } else {
                        var balanceInput = document.getElementById('openBalanceCurrentBalance');
                        balanceInput.value = '';
                        balanceInput.style.backgroundColor = '';
                        balanceInput.style.color = '';
                    }
                }
            });
        }

        function loadCustomerBalance(customerId) {
            var balanceInput = document.getElementById('openBalanceCurrentBalance');
            balanceInput.value = 'Loading...';
            balanceInput.style.backgroundColor = '#f8f9fa';
            balanceInput.style.color = '#6c757d';

            fetch('@Url.Content("~/Sales/GetPreviousDueAmount")?customerId=' + customerId)
                .then(function(r) { return r.json(); })
                .then(function(data) {
                    if (data.success && data.previousDueAmount !== undefined) {
                        var amount = parseFloat(data.previousDueAmount);
                        balanceInput.value = formatCurrency(amount);
                        balanceInput.style.backgroundColor = amount > 0 ? '#fff3cd' : '#d1edff';
                        balanceInput.style.color = amount > 0 ? '#856404' : '#0c5460';
                    } else {
                        balanceInput.value = formatCurrency(0);
                        balanceInput.style.backgroundColor = '';
                        balanceInput.style.color = '';
                    }
                })
                .catch(function() {
                    balanceInput.value = formatCurrency(0);
                    balanceInput.style.backgroundColor = '#f8d7da';
                    balanceInput.style.color = '#721c24';
                })
                .finally(function() {
                    setTimeout(function() {
                        balanceInput.style.backgroundColor = balanceInput.value === 'Rs 0.00' ? '' : balanceInput.style.backgroundColor;
                        balanceInput.style.color = balanceInput.value === 'Rs 0.00' ? '' : balanceInput.style.color;
                    }, 2000);
                });
        }

        function showCustomerOpenBalanceModal() {
            var combo = $("#openBalanceCustomerSelect").data("kendoComboBox");
            if (combo) {
                combo.value("");
            }
            $("#openBalanceCustomerIdHidden").val("");
            $("#openBalanceCurrentBalance").val('');
            // $("#openBalanceTypeSelect").val("");
            $("#openBalanceAmount").val('');
            var now = new Date();
            var year = now.getFullYear();
            var month = String(now.getMonth() + 1).padStart(2, '0');
            var day = String(now.getDate()).padStart(2, '0');
            $("#openBalanceDate").val(year + '-' + month + '-' + day);
            $("#openBalanceCustomerError").text('');
            $("#openBalanceTypeError").text('');
            $("#openBalanceAmountError").text('');
            $("#openBalanceDateError").text('');

            var modal = new bootstrap.Modal(document.getElementById('customerOpenBalanceModal'));
            modal.show();
        }

        function saveCustomerOpenBalance() {
            var customerId = $("#openBalanceCustomerIdHidden").val();
            // var type = $("#openBalanceTypeSelect").val();
            var amount = parseFloat($("#openBalanceAmount").val()) || 0;
            var balanceDate = $("#openBalanceDate").val();

            $("#openBalanceCustomerError").text('');
            $("#openBalanceTypeError").text('');
            $("#openBalanceAmountError").text('');
            $("#openBalanceDateError").text('');

            var isValid = true;
            if (!customerId) {
                $("#openBalanceCustomerError").text('Please select a customer');
                isValid = false;
            }
            // if (!type) {
            //     $("#openBalanceTypeError").text('Please select Payable or Receivable');
            //     isValid = false;
            // }
            if (amount <= 0) {
                $("#openBalanceAmountError").text('Please enter a valid opening balance');
                isValid = false;
            }
            if (!balanceDate) {
                $("#openBalanceDateError").text('Please select a date');
                isValid = false;
            }
            if (!isValid) return;

            var submitBtn = (event && event.target) ? event.target : document.getElementById('saveCustomerOpenBalanceBtn');
            if (submitBtn) {
                submitBtn.disabled = true;
                submitBtn.innerHTML = '<i class="fa-solid fa-spinner fa-spin me-1"></i>Saving...';
            }
            fetch('@Url.Action("SaveCustomerOpenBalance", "Sales")', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ customerId: parseInt(customerId, 10), openingBalance: amount, balanceDate: balanceDate })
            })
            .then(function(r) { return r.json(); })
            .then(function(data) {
                bootstrap.Modal.getInstance(document.getElementById('customerOpenBalanceModal')).hide();
                if (data.success) {
                    if (typeof toastr !== 'undefined') toastr.success(data.message || 'Opening balance saved.');
                    else alert(data.message || 'Opening balance saved.');
                } else {
                    if (typeof toastr !== 'undefined') toastr.error(data.message || 'Failed to save.');
                    else alert(data.message || 'Failed to save.');
                }
            })
            .catch(function(err) {
                console.error('Save opening balance error:', err);
                if (typeof toastr !== 'undefined') toastr.error('Error saving opening balance.');
                else alert('Error saving opening balance.');
            })
            .finally(function() {
                if (submitBtn) {
                    submitBtn.disabled = false;
                    submitBtn.innerHTML = '<i class="fa-solid fa-check me-1"></i>Save';
                }
            });
        }

        function initializeCustomerManagement() {
            // Add loading states to buttons
            addLoadingStates();
            
            // Add smooth animations
            addSmoothAnimations();
            
            // Add form validation feedback
            addFormValidation();
        }

        function addLoadingStates() {
            const searchBtn = document.querySelector('.btn-user-search');
            const resetBtn = document.querySelector('.btn-user-reset');
            
            if (searchBtn) {
                searchBtn.addEventListener('click', function() {
                    this.classList.add('btn-loading');
                    this.innerHTML = '<i class="fa-solid fa-spinner fa-spin me-2"></i>Searching...';
                });
            }
            
            if (resetBtn) {
                resetBtn.addEventListener('click', function() {
                    this.classList.add('btn-loading');
                    this.innerHTML = '<i class="fa-solid fa-spinner fa-spin me-2"></i>Refreshing...';
                });
            }
        }

        function addSmoothAnimations() {
            // Add hover effects to form elements
            const formElements = document.querySelectorAll('.form-floating');
            formElements.forEach(element => {
                element.addEventListener('mouseenter', function() {
                    this.style.transform = 'translateY(-2px)';
                    this.style.transition = 'transform 0.3s ease';
                });
                
                element.addEventListener('mouseleave', function() {
                    this.style.transform = 'translateY(0)';
                });
            });
        }

        function addFormValidation() {
            const inputs = document.querySelectorAll('.form-control, .form-select');
            inputs.forEach(input => {
                input.addEventListener('blur', function() {
                    if (this.value.trim() !== '') {
                        this.classList.add('is-valid');
                        this.classList.remove('is-invalid');
                    } else {
                        this.classList.remove('is-valid');
                    }
                });
                
                input.addEventListener('input', function() {
                    if (this.classList.contains('is-invalid')) {
                        this.classList.remove('is-invalid');
                    }
                });
            });
        }

        function SearchNameChange() {
            // Add loading state
            const searchBtn = document.querySelector('.btn-user-search');
            if (searchBtn) {
                searchBtn.classList.add('btn-loading');
            }
            
            // Get form values
            const form = document.querySelector('form');
            const formData = new FormData(form);
            const params = new URLSearchParams();
            
            // Add all form data to params
            for (let [key, value] of formData.entries()) {
                if (value.trim() !== '') {
                    params.append(key, value);
                }
            }
            
            // Add pagination
            params.set('pageNumber', '1');
            params.set('pageSize', document.getElementById('pageSize')?.value || '10');
            
            // Redirect with parameters
            window.location.href = '@Url.Action("Index", "Customer")' + '?' + params.toString();
        }

        function changePageSize(select) {
            // Add loading state
            const searchBtn = document.querySelector('.btn-user-search');
            if (searchBtn) {
                searchBtn.classList.add('btn-loading');
            }
            
            // Get current form values
            const form = document.querySelector('form');
            const formData = new FormData(form);
            const params = new URLSearchParams();
            
            // Add all form data to params
            for (let [key, value] of formData.entries()) {
                if (value.trim() !== '') {
                    params.append(key, value);
                }
            }
            
            // Add pagination
            params.set('pageNumber', '1');
            params.set('pageSize', select.value);
            
            // Redirect with parameters
            window.location.href = '@Url.Action("Index", "Customer")' + '?' + params.toString();
        }

        // Add keyboard shortcuts
        document.addEventListener('keydown', function(e) {
            // Ctrl + Enter to search
            if (e.ctrlKey && e.key === 'Enter') {
                e.preventDefault();
                const searchBtn = document.querySelector('.btn-user-search');
                if (searchBtn) {
                    searchBtn.click();
                }
            }
            
            // Escape to reset
            if (e.key === 'Escape') {
                const resetBtn = document.querySelector('.btn-user-reset');
                if (resetBtn) {
                    resetBtn.click();
                }
            }
        });

        // Add tooltips
        document.addEventListener('DOMContentLoaded', function() {
            const tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
            tooltipTriggerList.map(function (tooltipTriggerEl) {
                return new bootstrap.Tooltip(tooltipTriggerEl);
            });
        });

        function getCustomerExportParams() {
            const customerName = document.querySelector('input[name="Filters.CustomerName"]')?.value || '';
            const phoneNumber = document.querySelector('input[name="Filters.PhoneNumber"]')?.value || '';
            const email = document.querySelector('input[name="Filters.Email"]')?.value || '';
            return { customerName, phoneNumber, email };
        }

        document.getElementById("exportExcelBtn").addEventListener("click", function (e) {
            e.preventDefault();
            var p = getCustomerExportParams();
            var params = new URLSearchParams();
            if (p.customerName) params.set('customerName', p.customerName);
            if (p.phoneNumber) params.set('phoneNumber', p.phoneNumber);
            if (p.email) params.set('email', p.email);
            var url = '@Url.Action("ExportExcel", "Customer")' + (params.toString() ? '?' + params.toString() : '');
            exportWithLoader(url, 'Customers_export.xlsx', 'Preparing Excel export... Please wait.');
        });

        document.getElementById("exportPdfBtn").addEventListener("click", function (e) {
            e.preventDefault();
            var p = getCustomerExportParams();
            var params = new URLSearchParams();
            if (p.customerName) params.set('customerName', p.customerName);
            if (p.phoneNumber) params.set('phoneNumber', p.phoneNumber);
            if (p.email) params.set('email', p.email);
            var url = '@Url.Action("ExportPdf", "Customer")' + (params.toString() ? '?' + params.toString() : '');
            exportWithLoader(url, 'Customers_export.pdf', 'Preparing PDF export... Please wait.');
        });
    </script>
}
