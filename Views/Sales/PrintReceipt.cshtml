@model IMS.Models.SalePrintViewModel
@{
    Layout = null;
    int srNo = 1;
    var displayName = !string.IsNullOrWhiteSpace(Model.CustomerUrduName) ? Model.CustomerUrduName : Model.CustomerName;
   
    var isCredit = Model.TotalDueAmount > 0;
    var linesSubtotal = Model.LinesPayableSubtotal > 0
        ? Model.LinesPayableSubtotal
        : (Model.SaleDetails?.Sum(d => d.PayableAmount) ?? 0m);
}
<!DOCTYPE html>
<html lang="ur" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sale Receipt - Bill #@Model.BillNumber</title>
    <style>
        @@page { size: A4; margin: 15mm; }
        * { box-sizing: border-box; }
        body {
            font-family: 'Noto Nastaliq Urdu', 'Urdu Typesetting', 'Jameel Noori Nastaleeq', 'Traditional Arabic', Tahoma, serif;
            font-size: 11pt;
            line-height: 1.4;
            color: #000;
            max-width: 210mm;
            margin: 0 auto;
            padding: 10px;
            direction: rtl;
        }
        .ltr { direction: ltr; text-align: left; }
        .receipt { border: 1px solid #333; padding: 12px; min-height: 270mm; }
        .receipt-letterhead {
            background-color: #ffeb3b;
            padding: 12px 10px 14px;
            margin: -12px -12px 10px -12px;
            border-bottom: 2px solid #222;
            -webkit-print-color-adjust: exact;
            print-color-adjust: exact;
        }
        .receipt-header { display: flex; justify-content: space-between; align-items: flex-start; gap: 12px; margin-bottom: 6px; }
        .contact-block { font-size: 12pt; line-height: 1.5; }
        .receipt-letterhead .contact-block { font-size: 14pt; line-height: 1.5; }
        .receipt-letterhead .contact-block .contact-name { font-weight: 900; margin-bottom: 4px; font-size: 20pt; }
        .receipt-letterhead .contact-block .contact-phone { font-weight: 800; font-size: 16pt; margin-top: 2px; }
        .contact-block.contact-right { text-align: right; }
        .contact-block.contact-left { text-align: left; }
        .header-center { text-align: center; margin-bottom: 8px; }
        .receipt-letterhead .business-name { font-size: 55pt; font-weight: 900; margin: 0; color: #10F; letter-spacing: 0.02em; }
        .receipt-letterhead .tagline { font-size: 17pt; font-weight: 800; color: #111; margin: 6px 0 4px; text-align: center; font-family: inherit; }
        .receipt-letterhead .address { font-size: 18pt; font-weight: 800; color: #111; margin: 4px 0 0; text-align: center; font-family: inherit; }
        hr { border: none; border-top: 1px dashed #000; margin: 8px 0; }
        /* Transaction strip: separate from letterhead; same yellow when printed; sizes unchanged */
        .receipt-meta-banner {
            background-color: #ffeb3b;
            margin: 0 -12px 10px -12px;
            padding: 10px 12px 10px;
            border-top: 1px dashed #000;
            border-bottom: 1px dashed #000;
            -webkit-print-color-adjust: exact;
            print-color-adjust: exact;
            font-size: 17pt;
            font-weight: 800;
            color: #111;
        }
        .receipt-meta-banner .info-row { display: flex; justify-content: space-between; margin: 0 0 6px; flex-wrap: wrap; gap: 8px; font-size: 17pt; font-weight: 800; }
        .receipt-meta-banner .info-item { display: flex; align-items: center; gap: 6px; font-weight: 800; }
        .receipt-meta-banner .info-label { font-weight: 900; }
        .receipt-meta-banner .payment-type { margin: 0; font-size: 10pt; font-weight: 800; line-height: 1.5; }
        .info-row { display: flex; justify-content: space-between; margin: 6px 0; flex-wrap: wrap; gap: 8px; }
        .info-item { display: flex; align-items: center; gap: 6px; }
        .info-label { font-weight: bold; }
        .payment-type { margin: 6px 0; font-size: 10pt; }
        table.items { width: 100%; border-collapse: collapse; margin: 10px 0; }
        table.items th, table.items td { border: 1px solid #333; padding: 6px 8px; }

            table.items th {
                background: #f0f0f0;
                font-weight: bold;
                font-size: x-large;
            }
        table.items .num { text-align: center; width: 40px; }
        table.items .desc { }
        table.items .qty { text-align: center; width: 100px; }
        table.items .wazn { text-align: center; width: 95px; }
        table.items .rate { text-align: left; width: 120px; }
        table.items .amt { text-align: left; width: 125px; }
        .total-row { margin-top: 10px; font-weight: bold; font-size: 12pt; }
        table.items tfoot td { border: 1px solid #333; padding: 6px 8px; background: #f8f8f8; }
        .total-summary-lines { margin-top: 8px; font-weight: bold; font-size: 12pt; line-height: 1.8; }
        .signature-line { margin-top: 20px; padding-top: 8px; border-top: 1px solid #333; }
        .footer-note { text-align: left; font-size: 9pt; margin-top: 12px; color: #555; }
        .receipt-brand-footer { text-align: center; margin-top: 14px; padding-top: 10px; border-top: 1px solid #e8e8e8; font-size: 8.5pt; color: #aaa; line-height: 1.5; }
        .receipt-brand-footer .receipt-brand-name { font-weight: 600; letter-spacing: 0.02em; color: #9a9a9a; }
        .receipt-brand-footer .receipt-brand-contact { margin-top: 2px; }
        .receipt-brand-footer a { color: #b0b0b0; text-decoration: none; }
        @@media print {
            body { padding: 0; }
            .no-print { display: none !important; }
            .receipt { border: none; box-shadow: none; }
        }
        .no-print { margin-top: 12px; }
        .btn { display: inline-block; padding: 8px 14px; margin: 4px; background: #007bff; color: #fff; text-decoration: none; border-radius: 4px; border: none; cursor: pointer; font-size: 14px; }
        .btn:hover { background: #0056b3; }
        .btn-print { background: #28a745; }
        .btn-print:hover { background: #1e7e34; }
    </style>
</head>
<body>
    <div class="receipt">
        <div class="receipt-letterhead">
            <div class="receipt-header">
                <div class="contact-block contact-right">
                    <div class="contact-name">اسد محمود</div>
                    <div class="contact-phone ltr">@(ViewBag.PhoneAsad1 ?? "0321-4438351")</div>
                    <div class="contact-phone ltr">@(ViewBag.PhoneAsad2 ?? "0319-4838351")</div>
                </div>
                <div class="header-center" style="flex: 1;">
                    <h1 class="business-name">@(ViewBag.BusinessName ?? "ایم ظہور ٹریڈرز")</h1>
                </div>
                <div class="contact-block contact-left">
                    <div class="contact-name">ندیم محمود</div>
                    <div class="contact-phone ltr">@(ViewBag.PhoneNadeem1 ?? "0321-4438350")</div>
                    <div class="contact-phone ltr">@(ViewBag.PhoneNadeem2 ?? "0300-9483508")</div>
                </div>
            </div>
            <p class="tagline">@(ViewBag.BusinessTagline ?? "ڈیلر: کھل، چوکر ، سوڑی، دانہ، بیج، کڑوی کھل وغیرہ تھوک و پر چون دستیاب ہے")</p>
            <p class="address">@(ViewBag.Address ?? "چھوٹا ساندہ بس سٹاپ مین بند روڈ لاہور") @(ViewBag.Landline ?? "37148045,37147571-042")</p>
        </div>
        <div class="receipt-meta-banner">
            <div class="info-row">
                <div class="info-item"><span class="info-label">نمبر:</span><span class="ltr">@Model.BillNumber</span></div>
                <div class="info-item"><span class="info-label">نام:</span><span>@displayName</span></div>
                <div class="info-item"><span class="info-label">تاریخ:</span><span class="ltr">@Model.SaleDate.ToString("dd-MMM-yyyy")</span></div>
            </div>
            <div class="payment-type">
                <span class="info-label">ادھار / نقد:</span> @(isCredit ? "ادھار" : "نقد")
                @if (ViewBag.MerchantCopy == true) { <span> (مرچنٹ کاپی)</span> }
                else { <span> (کسٹمر کاپی)</span> }
            </div>
        </div>
        <hr />
        <table class="items">
            <thead>
                <tr>
                    <th class="num">#</th>
                    <th class="desc">تفصیل</th>
                    <th class="qty">تعداد</th>
                    <th class="wazn">وزن</th>
                    <th class="rate">نرخ</th>
                    <th class="amt">قیمت</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.SaleDetails != null && Model.SaleDetails.Any())
                {
                    @foreach (var item in Model.SaleDetails)
                    {
                        var lineTotal = item.SalePrice * item.PrintQuantity;
                        var qtyOnly = item.PrintQuantity.ToString("N0");
                        var displayMU = !string.IsNullOrWhiteSpace(item.UrduNameMU) ? item.UrduNameMU : (item.MeasuringUnitAbbreviation ?? string.Empty);
                        if (string.IsNullOrWhiteSpace(displayMU)) { displayMU = "—"; }
                        var descEnglish = !string.IsNullOrWhiteSpace(item.ProductRangeUrduName)
                        ? item.ProductRangeUrduName
                            : item.ProductRangeName;
                        <tr>
                            <td class="num ltr">@srNo</td>
                            <td class="desc">
                                @descEnglish

                             @*    <div class="ltr" style="text-align: left; direction: ltr;">@descEnglish</div>
                                @if (!string.IsNullOrWhiteSpace(item.ProductRangeUrduName))
                                {
                                    <div>@item.ProductRangeUrduName</div>
                                }
                                else if (!string.IsNullOrWhiteSpace(item.ProductUrduName))
                                {
                                    <div>@item.ProductUrduName</div>
                                } *@
                            </td>
                            <td class="qty ltr">@qtyOnly</td>
                            <td class="wazn">@displayMU</td>
                            <td class="rate ltr">@item.SalePrice.ToString("N2")</td>
                            <td class="amt ltr">@lineTotal.ToString("N2")</td>
                        </tr>
                        srNo++;
                    }
                }
                else
                {
                    <tr><td colspan="6" class="ltr" style="text-align:center;">No items</td></tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <td colspan="5" style="text-align: right;">میزان (سطریں):</td>
                    <td class="amt ltr">@linesSubtotal.ToString("N2")</td>
                </tr>
            </tfoot>
        </table>
        <div class="total-summary-lines">
            @if (Model.FreightAmount > 0)
            {
                <div><span>کرایہ:</span> <span class="ltr">@Model.FreightAmount.ToString("N2")</span></div>
            }
            <div><span>ٹوٹل (بل):</span> <span class="ltr">@Model.TotalAmount.ToString("N2")</span></div>
            @if (Model.DiscountAmount > 0) { <div><span>رعایت:</span> <span class="ltr">@Model.DiscountAmount.ToString("N2")</span></div> }
            <div><span>ادا شدہ:</span> <span class="ltr">@Model.TotalReceivedAmount.ToString("N2")</span></div>
            @if (Model.TotalDueAmount > 0) { <div><span>بقایا:</span> <span class="ltr">@Model.TotalDueAmount.ToString("N2")</span></div> }
        </div>
        <div class="signature-line">
            <span class="info-label">دستخط:</span> _______________________
        </div>
        <p class="footer-note ltr"> Generated by: @User.Identity?.Name</p>
        <div class="receipt-brand-footer ltr">
            <div class="receipt-brand-name">Developed By: AJ Core Technologies</div>
            <div class="receipt-brand-contact"><a href="mailto:awais.uet656@gmail.com">awais.uet656@gmail.com</a></div>
        </div>
    </div>
    <div class="no-print text-center">
        <button class="btn btn-print" onclick="window.print()">🖨️ Print</button>
        @if (ViewBag.MerchantCopy == true)
        { <a href="@Url.Action("PrintReceipt", "Sales", new { id = Model.SaleId, merchantCopy = false })" class="btn">👤 Customer Copy</a> }
        else
        { <a href="@Url.Action("PrintReceipt", "Sales", new { id = Model.SaleId, merchantCopy = true })" class="btn">🏪 Merchant Copy</a> }
        <a href="@Url.Action("Index", "Sales")" class="btn">📋 Back to Sales</a>
    </div>
    <script>
        (function() {
            var p = new URLSearchParams(window.location.search).get('print');
            if (p === 'true') setTimeout(function() { window.print(); }, 500);
        })();
    </script>
</body>
</html>
